<%- include("../../views/partials/user/header") %>

<% function buildQueryString(params) {
    const queryParams = new URLSearchParams();
    if (locals.search) queryParams.set('search', search);
    if (locals.selectedCategory) queryParams.set('category', selectedCategory);
    if (locals.selectedBrand) queryParams.set('brand', selectedBrand);
    if (locals.priceSort) queryParams.set('sort', priceSort);
    if (locals.minPrice !== undefined && locals.minPrice !== null) queryParams.set('gt', minPrice);
    if (locals.maxPrice !== undefined && locals.maxPrice !== null) queryParams.set('lt', maxPrice);
    
    // Override with new params
    for (const key in params) {
        if (params[key] === null || params[key] === undefined) {
            queryParams.delete(key);
        } else {
            queryParams.set(key, params[key]);
        }
    }
    const qs = queryParams.toString();
    return qs ? '?' + qs : '';
} %>

<style>
.shop-hero {
    padding: 60px 0 40px;
    border-bottom: 1px solid var(--border);
    background: linear-gradient(180deg, rgba(201,168,76,0.03) 0%, transparent 100%);
}
.shop-hero-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
}
.breadcrumb-te {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 12px;
}
.breadcrumb-te a { color: var(--text-muted); text-decoration: none; transition: color 0.3s; }
.breadcrumb-te a:hover { color: var(--gold); }
.breadcrumb-te i { font-size: 8px; }

/* Sort bar */
.sort-bar {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
}
.sort-select {
    padding: 10px 16px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text-secondary);
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    letter-spacing: 1px;
    cursor: pointer;
    outline: none;
    transition: border-color 0.3s;
}
.sort-select:focus { border-color: var(--gold); }
.sort-select option { background: var(--bg-card); color: var(--text-primary); }
.results-count {
    font-size: 12px;
    color: var(--text-muted);
    letter-spacing: 0.5px;
}

/* Layout */
.shop-layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 0;
    min-height: 60vh;
}

/* Sidebar */
.shop-sidebar {
    border-right: 1px solid var(--border);
    padding: 48px 36px 48px 0;
}
.sidebar-section {
    margin-bottom: 40px;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--border);
}
.sidebar-section:last-child { border-bottom: none; margin-bottom: 0; }
.sidebar-title {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 20px;
}

/* Filter list */
.filter-list { list-style: none; display: flex; flex-direction: column; gap: 10px; }
.filter-list li a {
    font-size: 13px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: all 0.3s;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 0;
    border-bottom: 1px solid transparent;
}
.filter-list li a:hover {
    color: var(--gold);
    border-bottom-color: rgba(201,168,76,0.2);
    padding-left: 6px;
}
.filter-list li.active a { color: var(--gold); }

/* Price range */
.price-inputs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-bottom: 14px;
}
.price-input {
    padding: 10px 12px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text-primary);
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    outline: none;
    transition: border-color 0.3s;
    width: 100%;
}
.price-input:focus { border-color: var(--gold); }

/* Products area */
.shop-products {
    padding: 48px 0 48px 48px;
}
.products-grid-shop {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 60px;
}
.product-card {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border);
    overflow: hidden;
    cursor: pointer;
    transition: var(--transition);
}
.product-card:hover {
    border-color: var(--gold);
    box-shadow: var(--shadow-gold);
}
.product-img-wrap {
    position: relative;
    aspect-ratio: 1/1;
    overflow: hidden;
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
}
.product-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}
.product-card:hover .product-img-wrap img {
    transform: scale(1.05);
}
.product-overlay {
    position: absolute;
    inset: 0;
    background: rgba(8, 8, 8, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
}
.product-card:hover .product-overlay {
    opacity: 1;
}
.product-quick-add {
    transform: translateY(10px);
    transition: transform 0.3s ease;
}
.product-card:hover .product-quick-add {
    transform: translateY(0);
}
.product-info {
    padding: 20px;
    border-top: 1px solid var(--border);
    background: var(--bg-card);
}
.product-brand {
    font-size: 10px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 6px;
}
.product-name {
    font-family: 'Playfair Display', serif;
    font-size: 1.05rem;
    font-weight: 400;
    color: var(--text-primary);
    margin-bottom: 10px;
    line-height: 1.4;
}
.product-price-row {
    display: flex;
    align-items: center;
    gap: 12px;
}
.price-sale {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-primary);
}
.price-original {
    font-size: 0.85rem;
    color: var(--text-muted);
    text-decoration: line-through;
}

/* Pagination */
.pagination-te {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
}
.page-btn {
    width: 40px; height: 40px;
    display: flex; align-items: center; justify-content: center;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 13px;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.3s;
    font-family: 'Inter', sans-serif;
}
.page-btn:hover, .page-btn.active {
    background: var(--gold-glow);
    border-color: var(--gold);
    color: var(--gold);
}
.page-btn.disabled {
    opacity: 0.3;
    pointer-events: none;
}

/* Empty state */
.empty-shop {
    grid-column: 1/-1;
    text-align: center;
    padding: 100px 20px;
}

/* Mobile sidebar toggle */
.sidebar-toggle {
    display: none;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-secondary);
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    cursor: pointer;
    transition: var(--transition);
}
.sidebar-toggle:hover { border-color: var(--gold); color: var(--gold); }

@media (max-width: 1024px) {
    .products-grid-shop { grid-template-columns: repeat(2, 1fr); }
    .shop-layout { grid-template-columns: 240px 1fr; }
}
@media (max-width: 768px) {
    .shop-layout { grid-template-columns: 1fr; }
    .shop-sidebar {
        display: none;
        border-right: none;
        border-bottom: 1px solid var(--border);
        padding: 24px 0;
    }
    .shop-sidebar.open { display: block; }
    .shop-products { padding: 32px 0; }
    .sidebar-toggle { display: flex; }
    .products-grid-shop { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 480px) {
    .products-grid-shop { grid-template-columns: 1fr; }
}
</style>

<!-- Shop Hero -->
<div class="shop-hero">
    <div class="te-container">
        <div class="shop-hero-inner">
            <div>
                <div class="breadcrumb-te">
                    <a href="/">Home</a>
                    <i class="fa-solid fa-chevron-right"></i>
                    <span style="color: var(--text-secondary);">Collections</span>
                </div>
                <h1 class="section-title">All <em>Collections</em></h1>
                <p style="font-size:13px; color:var(--text-secondary); margin-top:8px;">
                    <%= product.length %> timepieces curated for the discerning collector
                </p>
            </div>
            <div class="sort-bar" style="display: flex; gap: 10px; align-items: center;">
                <form action="/shop" method="GET" style="display: flex; gap: 5px; align-items: center;" id="searchForm">
                    <!-- Preserve existing filters -->
                    <% if (locals.selectedCategory) { %>
                        <input type="hidden" name="category" value="<%= selectedCategory %>">
                    <% } %>
                    <% if (locals.selectedBrand) { %>
                        <input type="hidden" name="brand" value="<%= selectedBrand %>">
                    <% } %>
                    <% if (locals.priceSort) { %>
                        <input type="hidden" name="sort" value="<%= priceSort %>">
                    <% } %>
                    <% if (locals.minPrice !== undefined && locals.minPrice !== null) { %>
                        <input type="hidden" name="gt" value="<%= minPrice %>">
                    <% } %>
                    <% if (locals.maxPrice !== undefined && locals.maxPrice !== null) { %>
                        <input type="hidden" name="lt" value="<%= maxPrice %>">
                    <% } %>
                    
                    <input type="text" name="search" placeholder="Search..." class="sort-select" style="width: 140px; margin: 0;" value="<%= locals.search || '' %>">
                    <button type="submit" class="sort-select" style="background: var(--gold); color: #080808; border-color: var(--gold); margin: 0; padding: 10px 14px;"><i class="fa-solid fa-magnifying-glass"></i></button>
                </form>
                <button class="sidebar-toggle" onclick="toggleSidebar()">
                    <i class="fa-solid fa-sliders"></i>
                    <span>Filters</span>
                </button>
                <select class="sort-select" onchange="handleSort(this.value)" id="sortSelect">
                    <option value="">Sort By</option>
                    <option value="price-asc" <%= locals.priceSort === 'price-asc' || locals.priceSort === 'asc' ? 'selected' : '' %>>Price: Low to High</option>
                    <option value="price-desc" <%= locals.priceSort === 'price-desc' || locals.priceSort === 'desc' ? 'selected' : '' %>>Price: High to Low</option>
                    <option value="newest" <%= locals.priceSort === 'newest' ? 'selected' : '' %>>Newest First</option>
                </select>
            </div>
        </div>
    </div>
</div>

<!-- Shop Body -->
<div class="te-container">
    <div class="shop-layout">

        <!-- Sidebar -->
        <aside class="shop-sidebar" id="shopSidebar">

            <!-- Categories -->
            <div class="sidebar-section">
                <div class="sidebar-title">Categories</div>
                <ul class="filter-list">
                    <li class="<%= !locals.selectedCategory ? 'active' : '' %>">
                        <a href="/shop<%= buildQueryString({ category: null, page: 1 }) %>">All Collections</a>
                    </li>
                    <% if (category && category.length > 0) { %>
                    <% category.forEach(cat => { %>
                    <li class="<%= (locals.selectedCategory && locals.selectedCategory.toString() === cat._id.toString()) ? 'active' : '' %>">
                        <a href="/shop<%= buildQueryString({ category: cat._id, page: 1 }) %>">
                            <%= cat.name %>
                        </a>
                    </li>
                    <% }) %>
                    <% } %>
                </ul>
            </div>

            <!-- Brands -->
            <div class="sidebar-section">
                <div class="sidebar-title">Brands</div>
                <ul class="filter-list">
                    <li class="<%= !locals.selectedBrand ? 'active' : '' %>">
                        <a href="/shop<%= buildQueryString({ brand: null, page: 1 }) %>">All Brands</a>
                    </li>
                    <% if (brand && brand.length > 0) { %>
                    <% brand.forEach(b => { %>
                    <li class="<%= (locals.selectedBrand && locals.selectedBrand.toString() === b._id.toString()) ? 'active' : '' %>">
                        <a href="/shop<%= buildQueryString({ brand: b._id, page: 1 }) %>"><%= b.name %></a>
                    </li>
                    <% }) %>
                    <% } %>
                </ul>
            </div>

            <!-- Price range -->
            <div class="sidebar-section">
                <div class="sidebar-title">Price Range</div>
                <div class="price-inputs">
                    <input type="number" class="price-input" id="priceMin" placeholder="₹ Min" min="0" value="<%= locals.minPrice || '' %>">
                    <input type="number" class="price-input" id="priceMax" placeholder="₹ Max" value="<%= locals.maxPrice || '' %>">
                </div>
                <button class="btn-gold" style="width:100%; justify-content:center; padding:11px;" onclick="applyPriceFilter()">
                    <span>Apply</span>
                </button>
            </div>

        </aside>

        <!-- Products -->
        <main class="shop-products">
            <div class="products-grid-shop">
                <% if (product && product.length > 0) { %>
                <% product.forEach((product, i) => { %>
                <div class="product-card animate-up delay-<%= (i % 3) + 1 %>" style="position:relative; background:var(--bg-primary);">
                    <div class="wishlist-button" style="position: absolute; top: 15px; right: 15px; z-index: 10; cursor: pointer; color: var(--gold); font-size: 18px;">
                         <i class="bi <%= product.inWishlist ? 'bi-heart-fill text-danger' : 'bi-heart' %>"
                            id="wishlist-icon-<%= product._id %>" data-id="<%= product._id %>"></i>
                    </div>

                    <% if (product.bestOffer > 0) { %><span class="card-badge" style="background:transparent; border:1px solid var(--gold); color:var(--gold);">-<%= product.bestOffer %>%</span><% } %>

                    <a href="/productDetails?id=<%= product._id %>" style="text-decoration:none; display:block;">
                        <div class="product-img-wrap">
                            <img src="/uploads/productImages/<%= product.productImage[0] %>" alt="<%= product.productName %>" loading="lazy">
                            <% if (product.quantity <= 0) { %>
                            <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); display: flex; align-items: center; justify-content: center; z-index: 5;">
                                <span style="color: #ff4d4d; font-weight: bold; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; border: 1.5px solid #ff4d4d; padding: 4px 8px; background: rgba(8,8,8,0.85);">Out of Stock</span>
                            </div>
                            <% } %>
                            <div class="product-overlay">
                                <div class="product-quick-add">
                                    <span class="btn-gold" style="padding:10px 20px; font-size:10px;">View Details</span>
                                </div>
                            </div>
                        </div>
                    </a>
                    <div class="product-info">
                        <div class="product-brand"><%= product.brand ? product.brand.name : '' %></div>
                        <div class="product-name"><%= product.productName %></div>
                        <div class="product-price-row" style="display: flex; justify-content: space-between; align-items: center;">
                            <div>
                                <% if (product.bestOffer > 0) { %>
                                <span class="price-sale">₹<%= product.finalPrice.toLocaleString('en-IN') %></span>
                                <span class="price-original">₹<%= product.salePrice.toLocaleString('en-IN') %></span>
                                <% } else { %>
                                <span class="price-sale">₹<%= product.salePrice.toLocaleString('en-IN') %></span>
                                <% if (product.regularPrice > product.salePrice) { %>
                                <span class="price-original">₹<%= product.regularPrice.toLocaleString('en-IN') %></span>
                                <% } %>
                                <% } %>
                            </div>
                            <% if (product.quantity > 0) { %>
                            <button class="add-to-cart btn-gold" data-id="<%= product._id %>" data-quantity="1" style="padding: 6px 12px; font-size: 9px; letter-spacing: 1px; border: 1px solid var(--gold); background: transparent;">
                                <i class="fa-solid fa-plus"></i> Add
                            </button>
                            <% } else { %>
                            <button class="btn-gold" disabled style="padding: 6px 12px; font-size: 9px; letter-spacing: 1px; border: 1px solid var(--border); background: transparent; color: var(--text-muted); cursor: not-allowed;">
                                Out of Stock
                            </button>
                            <% } %>
                        </div>
                    </div>
                </div>
                <% }) %>
                <% } else { %>
                <div class="empty-shop">
                    <i class="fa-regular fa-clock" style="font-size:56px; color:var(--text-muted); display:block; margin-bottom:20px;"></i>
                    <p style="font-family:'Playfair Display',serif; font-size:1.3rem; color:var(--text-secondary); margin-bottom:8px;">No timepieces found</p>
                    <p style="font-size:13px; color:var(--text-muted);">Try adjusting your filters or browse all collections.</p>
                    <br>
                    <a href="/shop" class="btn-gold" style="margin-top:16px;">Browse All</a>
                </div>
                <% } %>
            </div>

            <!-- Pagination -->
            <% if (totalpage > 1) { %>
            <div class="pagination-te">
                <% if (currentpage > 1) { %>
                <a href="/shop<%= buildQueryString({ page: currentpage - 1 }) %>" class="page-btn"><i class="fa-solid fa-chevron-left"></i></a>
                <% } %>
                <% for (let p = 1; p <= totalpage; p++) { %>
                <a href="/shop<%= buildQueryString({ page: p }) %>" class="page-btn <%= p === currentpage ? 'active' : '' %>"><%= p %></a>
                <% } %>
                <% if (currentpage < totalpage) { %>
                <a href="/shop<%= buildQueryString({ page: currentpage + 1 }) %>" class="page-btn"><i class="fa-solid fa-chevron-right"></i></a>
                <% } %>
            </div>
            <% } %>
        </main>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<script>
function toggleSidebar() {
    document.getElementById('shopSidebar').classList.toggle('open');
}

function applyPriceFilter() {
    const min = document.getElementById('priceMin').value;
    const max = document.getElementById('priceMax').value;
    const urlParams = new URLSearchParams(window.location.search);
    if (min) urlParams.set('gt', min); else urlParams.delete('gt');
    if (max) urlParams.set('lt', max); else urlParams.delete('lt');
    urlParams.set('page', '1');
    window.location.href = '/shop?' + urlParams.toString();
}

function handleSort(val) {
    const urlParams = new URLSearchParams(window.location.search);
    if (val) {
        urlParams.set('sort', val);
    } else {
        urlParams.delete('sort');
    }
    urlParams.set('page', '1');
    window.location.href = '/shop?' + urlParams.toString();
}

// Add to Cart
const addToCartbtn = document.querySelectorAll('.add-to-cart');
addToCartbtn.forEach(function (button) {
    button.addEventListener('click', function (event) {
        event.preventDefault();
        const productId = this.getAttribute('data-id');
        const quantity = this.getAttribute('data-quantity');

        $.ajax({
            url: '/check-auth',
            method: 'GET',
            success: function (response) {
                if (response.isLoggedIn) {
                    addProductToCart(productId, quantity);
                } else {
                    Swal.fire({
                        icon: 'info',
                        title: 'Login Required',
                        text: 'Please login to add items to your cart',
                        showCancelButton: true,
                        confirmButtonText: 'Go to Login',
                        cancelButtonText: 'Cancel'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = '/login';
                        }
                    });
                }
            },
            error: function (xhr, status, error) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Something went wrong. Please try again later.',
                });
            }
        });
    });
});

function addProductToCart(productId, quantity) {
    $.ajax({
        url: `/addToCart/${productId}`,
        method: 'POST',
        data: JSON.stringify({ quantity: quantity }),
        contentType: 'application/json',
        success: function (response) {
            if (response.cartCount !== undefined) {
                $('#cartCount').text(response.cartCount);
            }
            Swal.fire({
                icon: 'success',
                title: 'Added to Cart',
                text: response.message,
                confirmButtonText: 'OK',
                confirmButtonColor: '#c9a84c'
            }).then(() => {
                Swal.fire({
                    title: 'Go to cart?',
                    text: 'Do you want to go to cart?',
                    showCancelButton: true,
                    confirmButtonText: "YES",
                    cancelButtonText: "NO",
                    confirmButtonColor: '#c9a84c'
                }).then((confirmation) => {
                    if (confirmation.isConfirmed) {
                        window.location.href = '/cart';
                    }
                });
            });
        },
        error: function (xhr, status, error) {
            let errorMessage = "Error while adding to cart. Please try again!";
            try {
                const response = JSON.parse(xhr.responseText);
                if (response && response.message) {
                    errorMessage = response.message;
                }
            } catch (e) {
                console.error('Error parsing error response', e);
            }
            Swal.fire({
                icon: "error",
                title: "Error",
                text: errorMessage,
                confirmButtonText: 'OK',
                confirmButtonColor: '#c9a84c'
            });
        }
    });
}

// Wishlist Toggler
const addToWishbtn = document.querySelectorAll('.bi-heart, .bi-heart-fill');
addToWishbtn.forEach(function (button) {
    button.addEventListener('click', function (event) {
        event.preventDefault();
        const productId = this.getAttribute('data-id');
        const icon = document.getElementById(`wishlist-icon-${productId}`);

        $.ajax({
            url: '/check-auth',
            method: 'GET',
            success: function (response) {
                if (response.isLoggedIn) {
                    updateWishlist(productId, icon);
                } else {
                    Swal.fire({
                        icon: 'info',
                        title: 'Login Required',
                        text: 'Please login to add items to your wishlist',
                        showCancelButton: true,
                        confirmButtonText: 'Go to Login',
                        cancelButtonText: 'Cancel'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = '/login';
                        }
                    });
                }
            },
            error: function (xhr, status, error) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Something went wrong. Please try again later.',
                });
            }
        });
    });
});

function updateWishlist(productId, icon) {
    $.ajax({
        url: `/addToWishlist/${productId}`,
        method: 'POST',
        data: JSON.stringify({ productId: productId }),
        contentType: "application/json",
        success: function (response) {
            if (response.success) {
                if (response.action === 'added') {
                    icon.classList.remove('bi-heart');
                    icon.classList.add('bi-heart-fill', 'text-danger');
                    Swal.fire({
                        icon: 'success',
                        title: "Added to Wishlist",
                        text: response.message,
                        confirmButtonText: 'OK',
                        confirmButtonColor: '#c9a84c'
                    });
                } else if (response.action === 'removed') {
                    icon.classList.remove('bi-heart-fill', 'text-danger');
                    icon.classList.add('bi-heart');
                    Swal.fire({
                        icon: 'success',
                        title: "Removed from Wishlist",
                        text: response.message,
                        confirmButtonText: 'OK',
                        confirmButtonColor: '#c9a84c'
                    });
                }
            }
        },
        error: function (xhr, status, error) {
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Error while updating the wishlist.',
                confirmButtonText: "Ok",
                confirmButtonColor: '#c9a84c'
            });
        }
    });
}

document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.bi-heart-fill').forEach(function (icon) {
        icon.classList.add('text-danger');
    });
});
</script>

