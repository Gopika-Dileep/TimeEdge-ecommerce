<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify OTP — TimeEdge</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        :root { --bg-primary:#080808; --bg-secondary:#111111; --bg-card:#161616; --gold:#c9a84c; --gold-light:#e8c96d; --gold-glow:rgba(201,168,76,0.12); --text-primary:#f0ede8; --text-secondary:#a09484; --text-muted:#5a5248; --border:rgba(201,168,76,0.2); --transition:all 0.35s cubic-bezier(0.4,0,0.2,1); }
        *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
        body { background:var(--bg-primary); color:var(--text-primary); font-family:'Inter',sans-serif; min-height:100vh; display:flex; align-items:center; justify-content:center; padding:40px 20px; }
        .otp-card { width:100%; max-width:460px; background:var(--bg-secondary); border:1px solid var(--border); padding:60px 52px; text-align:center; }
        .otp-logo { font-family:'Playfair Display',serif; font-size:18px; font-weight:700; letter-spacing:3px; text-transform:uppercase; color:var(--text-primary); text-decoration:none; display:block; margin-bottom:40px; }
        .otp-logo span { color:var(--gold); }
        .otp-icon { width:64px; height:64px; border:1px solid var(--border); border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 24px; color:var(--gold); font-size:24px; }
        .otp-title { font-family:'Playfair Display',serif; font-size:1.8rem; font-weight:400; color:var(--text-primary); margin-bottom:10px; }
        .otp-sub { font-size:13px; color:var(--text-secondary); line-height:1.6; margin-bottom:36px; }
        .otp-email { color:var(--gold); font-weight:500; }
        /* OTP inputs */
        .otp-inputs { display:flex; gap:10px; justify-content:center; margin-bottom:28px; }
        .otp-digit {
            width:52px; height:58px; text-align:center; font-size:22px; font-weight:500;
            background:rgba(255,255,255,0.03); border:1px solid var(--border);
            color:var(--text-primary); font-family:'Playfair Display',serif;
            outline:none; transition:var(--transition); border-bottom:2px solid rgba(201,168,76,0.3);
        }
        .otp-digit:focus { border-color:var(--gold); background:var(--gold-glow); }
        .btn-submit { width:100%; padding:15px; background:var(--gold); border:none; color:#080808; font-family:'Inter',sans-serif; font-size:11px; font-weight:600; letter-spacing:3px; text-transform:uppercase; cursor:pointer; transition:var(--transition); }
        .btn-submit:hover { background:var(--gold-light); box-shadow:0 0 30px rgba(201,168,76,0.3); }
        .resend-row { margin-top:24px; font-size:12px; color:var(--text-muted); }
        .resend-btn { background:none; border:none; color:var(--gold); cursor:pointer; font-size:12px; transition:color 0.3s; font-family:'Inter',sans-serif; }
        .resend-btn:hover { color:var(--gold-light); }
        .timer-text { color:var(--text-muted); }
        .auth-alert { padding:13px 16px; background:rgba(201,60,60,0.08); border:1px solid rgba(201,60,60,0.25); color:#e07070; font-size:12px; margin-bottom:24px; display:flex; align-items:center; gap:10px; border-radius:0; }
    </style>
</head>
<body>
<div class="otp-card">
    <a href="/" class="otp-logo"><span>TIME</span> EDGE</a>
    <div class="otp-icon"><i class="fa-regular fa-envelope"></i></div>
    <h1 class="otp-title">Verify your email</h1>
    <p class="otp-sub">
        We sent a 6-digit code to<br>
        <span class="otp-email"><%= typeof email !== 'undefined' ? email : 'your email' %></span>
    </p>

    <% if (typeof message !== 'undefined' && message) { %>
    <div class="auth-alert"><i class="fa-solid fa-circle-exclamation"></i><%= message %></div>
    <% } %>

    <form action="/verifyotp" method="POST" id="otpForm">
        <div class="otp-inputs">
            <input type="text" class="otp-digit" maxlength="1" id="d1" autofocus>
            <input type="text" class="otp-digit" maxlength="1" id="d2">
            <input type="text" class="otp-digit" maxlength="1" id="d3">
            <input type="text" class="otp-digit" maxlength="1" id="d4">
            <input type="text" class="otp-digit" maxlength="1" id="d5">
            <input type="text" class="otp-digit" maxlength="1" id="d6">
        </div>
        <input type="hidden" name="otp" id="otpHidden">
        <button type="submit" class="btn-submit">
            Verify &nbsp; <i class="fa-solid fa-arrow-right"></i>
        </button>
    </form>

    <div class="resend-row">
        Didn't receive the code?
        <span id="timerText" class="timer-text">Resend in <span id="countdown">30</span>s</span>
        <form action="/resend-otp" method="POST" id="resendForm" style="display:inline;">
            <button type="submit" class="resend-btn" id="resendBtn" style="display:none;">Resend OTP</button>
        </form>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
const digits = document.querySelectorAll('.otp-digit');
digits.forEach((d, i) => {
    d.addEventListener('input', () => {
        if (d.value && i < 5) digits[i+1].focus();
        combineOtp();
    });
    d.addEventListener('keydown', e => {
        if (e.key === 'Backspace' && !d.value && i > 0) digits[i-1].focus();
    });
    d.addEventListener('paste', e => {
        const text = e.clipboardData.getData('text').trim();
        if (/^\d{6}$/.test(text)) {
            text.split('').forEach((ch, idx) => { if (digits[idx]) digits[idx].value = ch; });
            combineOtp(); digits[5].focus();
        }
        e.preventDefault();
    });
});
function combineOtp() {
    document.getElementById('otpHidden').value = Array.from(digits).map(d => d.value).join('');
}

// Countdown
let secs = 60;
let timer;
function startTimer() {
    clearInterval(timer);
    const cdown = document.getElementById('countdown');
    timer = setInterval(() => {
        secs--;
        if (cdown) cdown.textContent = secs;
        if (secs <= 0) {
            clearInterval(timer);
            document.getElementById('timerText').style.display = 'none';
            document.getElementById('resendBtn').style.display = 'inline';
        }
    }, 1000);
}

$(document).ready(function() {
    startTimer();

    $('#otpForm').on('submit', function(e) {
        e.preventDefault();
        combineOtp();
        const otp = $('#otpHidden').val();
        const userId = '<%= userId %>';

        if (otp.length < 6) {
            Swal.fire({
                icon: 'warning',
                title: 'Invalid OTP',
                text: 'Please enter all 6 digits.',
                confirmButtonColor: '#c9a84c'
            });
            return;
        }

        $.ajax({
            url: '/otpverify',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ userId, otp }),
            success: function(response) {
                Swal.fire({
                    icon: 'success',
                    title: 'Verified',
                    text: 'Your email has been verified successfully!',
                    confirmButtonColor: '#c9a84c'
                }).then(() => {
                    window.location.href = '/login';
                });
            },
            error: function(xhr) {
                const err = xhr.responseJSON?.message || 'Verification failed. Please try again.';
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: err,
                    confirmButtonColor: '#c9a84c'
                });
            }
        });
    });

    $('#resendForm').on('submit', function(e) {
        e.preventDefault();
        const userId = '<%= userId %>';

        $.ajax({
            url: '/resend-otp',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ userId }),
            success: function(response) {
                Swal.fire({
                    icon: 'success',
                    title: 'OTP Resent',
                    text: 'A new OTP code has been sent to your email.',
                    confirmButtonColor: '#c9a84c'
                });
                secs = 60;
                $('#countdown').text(secs);
                document.getElementById('timerText').style.display = 'inline';
                document.getElementById('resendBtn').style.display = 'none';
                startTimer();
            },
            error: function(xhr) {
                const err = xhr.responseJSON?.message || 'Failed to resend OTP.';
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: err,
                    confirmButtonColor: '#c9a84c'
                });
            }
        });
    });
});
</script>
</body>
</html>
