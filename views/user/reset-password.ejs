<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password — TimeEdge</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        :root { --bg-primary:#080808; --bg-secondary:#111111; --gold:#c9a84c; --gold-light:#e8c96d; --gold-glow:rgba(201,168,76,0.12); --text-primary:#f0ede8; --text-secondary:#a09484; --text-muted:#5a5248; --border:rgba(201,168,76,0.2); --transition:all 0.35s cubic-bezier(0.4,0,0.2,1); }
        *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
        body { background:var(--bg-primary); color:var(--text-primary); font-family:'Inter',sans-serif; min-height:100vh; display:flex; align-items:center; justify-content:center; padding:40px 20px; }
        .auth-mini-card { width:100%; max-width:460px; background:var(--bg-secondary); border:1px solid var(--border); padding:56px 48px; }
        .otp-logo { font-family:'Playfair Display',serif; font-size:18px; font-weight:700; letter-spacing:3px; text-transform:uppercase; color:var(--text-primary); text-decoration:none; display:block; margin-bottom:40px; }
        .otp-logo span { color:var(--gold); }
        .auth-eyebrow { font-size:10px; letter-spacing:4px; text-transform:uppercase; color:var(--gold); margin-bottom:14px; }
        .auth-title { font-family:'Playfair Display',serif; font-size:1.9rem; font-weight:400; color:var(--text-primary); margin-bottom:8px; }
        .auth-title em { font-style:italic; color:var(--gold); }
        .auth-sub { font-size:13px; color:var(--text-secondary); line-height:1.6; margin-bottom:36px; }
        .form-group { margin-bottom:22px; position:relative; }
        .form-label { display:block; font-size:10px; letter-spacing:2.5px; text-transform:uppercase; color:var(--text-secondary); margin-bottom:10px; }
        .form-input { width:100%; padding:14px 48px 14px 16px; background:rgba(255,255,255,0.03); border:1px solid var(--border); color:var(--text-primary); font-family:'Inter',sans-serif; font-size:14px; outline:none; transition:var(--transition); }
        .form-input:focus { border-color:var(--gold); background:var(--gold-glow); }
        .form-input::placeholder { color:var(--text-muted); }
        .eye-btn { position:absolute; right:14px; bottom:14px; background:none; border:none; color:var(--text-muted); cursor:pointer; font-size:14px; transition:color 0.3s; }
        .eye-btn:hover { color:var(--gold); }
        .strength-bar { height:3px; background:var(--border); margin-top:8px; border-radius:2px; overflow:hidden; }
        .strength-fill { height:100%; width:0%; transition:width 0.4s ease, background 0.4s ease; }
        .btn-submit { width:100%; padding:15px; background:var(--gold); border:none; color:#080808; font-family:'Inter',sans-serif; font-size:11px; font-weight:600; letter-spacing:3px; text-transform:uppercase; cursor:pointer; transition:var(--transition); }
        .btn-submit:hover { background:var(--gold-light); box-shadow:0 0 30px rgba(201,168,76,0.3); }
        .auth-alert { padding:13px 16px; background:rgba(201,60,60,0.08); border:1px solid rgba(201,60,60,0.25); color:#e07070; font-size:12px; margin-bottom:24px; display:flex; align-items:center; gap:10px; }
    </style>
</head>
<body>
<div class="auth-mini-card">
    <a href="/" class="otp-logo"><span>TIME</span> EDGE</a>
    <div class="auth-eyebrow">Security</div>
    <h1 class="auth-title">New <em>Password</em></h1>
    <p class="auth-sub">Choose a strong password to secure your TimeEdge account.</p>

    <% if (typeof message !== 'undefined' && message) { %>
    <div class="auth-alert" id="authAlert"><i class="fa-solid fa-circle-exclamation"></i><span id="authAlertText"><%= message %></span></div>
    <% } else { %>
    <div class="auth-alert" id="authAlert" style="display:none;"><i class="fa-solid fa-circle-exclamation"></i><span id="authAlertText"></span></div>
    <% } %>

    <form id="resetForm" onsubmit="submitReset(event)">
        <input type="hidden" name="email" id="emailField" value="">
        <div class="form-group">
            <label class="form-label" for="newPassword">New Password</label>
            <input type="password" class="form-input" id="newPassword" name="newPassword" placeholder="Min. 8 characters" required oninput="checkStrength(this.value)">
            <button type="button" class="eye-btn" onclick="togglePwd('newPassword')"><i class="fa-regular fa-eye"></i></button>
            <div class="strength-bar"><div class="strength-fill" id="strengthFill"></div></div>
        </div>
        <div class="form-group">
            <label class="form-label" for="confirmPassword">Confirm Password</label>
            <input type="password" class="form-input" id="confirmPassword" name="confirmPassword" placeholder="Repeat password" required>
            <button type="button" class="eye-btn" onclick="togglePwd('confirmPassword')"><i class="fa-regular fa-eye"></i></button>
        </div>
        <button type="submit" class="btn-submit">Update Password &nbsp; <i class="fa-solid fa-lock"></i></button>
    </form>
</div>

<script>
// Extract email from URL
const urlParams = new URLSearchParams(window.location.search);
const email = urlParams.get('email') || '';
document.getElementById('emailField').value = email;

function togglePwd(id) {
    const f = document.getElementById(id);
    f.type = f.type === 'password' ? 'text' : 'password';
}

function checkStrength(val) {
    const fill = document.getElementById('strengthFill');
    let strength = 0;
    if (val.length >= 8) strength++;
    if (/[A-Z]/.test(val)) strength++;
    if (/[0-9]/.test(val)) strength++;
    if (/[^A-Za-z0-9]/.test(val)) strength++;
    const pcts = ['0%','25%','50%','75%','100%'];
    const colors = ['#e07070','#e07070','#f0b430','#6dbf7f','#4caf50'];
    fill.style.width = pcts[strength];
    fill.style.background = colors[strength];
}

function displayError(msg) {
    const alertEl = document.getElementById('authAlert');
    const textEl = document.getElementById('authAlertText');
    textEl.textContent = msg;
    alertEl.style.display = 'flex';
}

async function submitReset(e) {
    e.preventDefault();
    const np = document.getElementById('newPassword').value;
    const cp = document.getElementById('confirmPassword').value;
    if (np !== cp) {
        return displayError('Passwords do not match!');
    }
    const formData = new FormData(e.target);
    const body = Object.fromEntries(formData.entries());
    const res = await fetch('/reset-password', {
        method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body)
    });
    const data = await res.json();
    if (data.success) {
        window.location.href = data.redirectUrl;
    } else {
        displayError(data.message || 'Failed to reset password.');
    }
}
</script>
</body>
</html>