<%- include("../../views/partials/user/header") %>

<style>
.cart-page { padding: 60px 0 100px; min-height: 70vh; }
.cart-header-row { display:flex; align-items:baseline; justify-content:space-between; margin-bottom:48px; gap:16px; flex-wrap:wrap; }

/* Cart table */
.cart-table { width:100%; border-collapse:collapse; margin-bottom:40px; }
.cart-table thead tr th {
    font-size:10px; letter-spacing:3px; text-transform:uppercase;
    color:var(--gold); font-weight:500; padding:16px 0;
    border-bottom:1px solid var(--border); text-align:left;
}
.cart-table thead tr th:last-child { text-align:right; }
.cart-table tbody tr { border-bottom:1px solid var(--border); transition:background 0.3s; }
.cart-table tbody tr:hover { background:rgba(201,168,76,0.02); }

.cart-img-cell { width:100px; padding:20px 20px 20px 0; }
.cart-img-wrap { width:80px; height:80px; overflow:hidden; border:1px solid var(--border); }
.cart-img-wrap img { width:100%; height:100%; object-fit:cover; }

.cart-name-cell { padding:20px; }
.cart-product-brand { font-size:10px; letter-spacing:2px; text-transform:uppercase; color:var(--gold); margin-bottom:4px; }
.cart-product-name { font-family:'Playfair Display',serif; font-size:1rem; font-weight:400; color:var(--text-primary); }

.cart-qty-cell { padding:20px; }
.qty-control-sm { display:flex; align-items:center; border:1px solid var(--border); width:fit-content; }
.qty-btn-sm { width:36px; height:36px; background:transparent; border:none; color:var(--text-secondary); font-size:13px; cursor:pointer; transition:var(--transition); display:flex; align-items:center; justify-content:center; }
.qty-btn-sm:hover { color:var(--gold); background:var(--gold-glow); }
.qty-num { width:40px; text-align:center; font-size:14px; color:var(--text-primary); line-height:36px; border-left:1px solid var(--border); border-right:1px solid var(--border); }

.cart-price-cell { padding:20px; font-size:1rem; color:var(--text-primary); font-weight:500; text-align:right; white-space:nowrap; }
.cart-remove { background:none; border:none; color:var(--text-muted); font-size:14px; cursor:pointer; transition:color 0.3s; padding:4px; }
.cart-remove:hover { color:#e07070; }

/* Summary card */
.cart-layout { display:grid; grid-template-columns:1fr 380px; gap:40px; align-items:start; }
.order-summary-card {
    background:var(--bg-card); border:1px solid var(--border);
    padding:36px; position:sticky; top:100px;
}
.summary-title { font-size:10px; letter-spacing:3px; text-transform:uppercase; color:var(--gold); margin-bottom:28px; }
.summary-row { display:flex; align-items:center; justify-content:space-between; padding:12px 0; border-bottom:1px solid var(--border); font-size:13px; }
.summary-row:last-of-type { border-bottom:none; }
.summary-label { color:var(--text-secondary); }
.summary-val { color:var(--text-primary); font-weight:500; }
.summary-total { padding:20px 0 28px; }
.summary-total-label { font-size:10px; letter-spacing:3px; text-transform:uppercase; color:var(--text-muted); margin-bottom:6px; }
.summary-total-val { font-family:'Playfair Display',serif; font-size:2rem; font-weight:400; color:var(--text-primary); }

/* Empty cart */
.cart-empty { text-align:center; padding:100px 20px; }
.cart-empty i { font-size:56px; color:var(--text-muted); margin-bottom:20px; display:block; }
.cart-empty p { font-family:'Playfair Display',serif; font-size:1.4rem; color:var(--text-secondary); margin-bottom:8px; }
.cart-empty span { font-size:13px; color:var(--text-muted); }

@media (max-width:960px) { .cart-layout { grid-template-columns:1fr; } .order-summary-card { position:static; } }
@media (max-width:640px) {
    .cart-table thead { display:none; }
    .cart-table tbody tr { display:block; padding:16px 0; }
    .cart-img-cell, .cart-name-cell, .cart-qty-cell, .cart-price-cell { display:block; padding:4px 0; }
}
</style>

<div class="te-container cart-page">
    <!-- Header -->
    <div class="cart-header-row animate-up">
        <div>
            <span class="section-label">Your Selection</span>
            <h1 class="section-title">Shopping <em>Cart</em></h1>
        </div>
        <a href="/shop" style="font-size:11px; letter-spacing:2px; text-transform:uppercase; color:var(--text-muted); text-decoration:none; display:flex; align-items:center; gap:8px; transition:color 0.3s;" onmouseover="this.style.color='var(--gold)'" onmouseout="this.style.color='var(--text-muted)'">
            <i class="fa-solid fa-arrow-left"></i> Continue Shopping
        </a>
    </div>

    <% if (typeof cart !== 'undefined' && cart && cart.items && cart.items.length > 0) { %>
    <div class="cart-layout">
        <!-- Items -->
        <div class="animate-up">
            <table class="cart-table">
                <thead>
                    <tr>
                        <th colspan="2">Product</th>
                        <th>Quantity</th>
                        <th style="text-align:right;">Price</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="cartBody">
                    <% cart.items.forEach(item => { %>
                    <tr id="row-<%= item._id %>">
                        <td class="cart-img-cell">
                            <div class="cart-img-wrap">
                                <img src="/uploads/productImages/<%= item.productId.productImage[0] %>" alt="<%= item.productId.productName %>">
                            </div>
                        </td>
                        <td class="cart-name-cell">
                            <div class="cart-product-brand"><%= item.productId.brand %></div>
                            <div class="cart-product-name"><%= item.productId.productName %></div>
                            <div style="font-size:12px; color:var(--text-muted); margin-top:4px;">₹<%= item.productId.salePrice.toLocaleString('en-IN') %> each</div>
                        </td>
                        <td class="cart-qty-cell">
                            <div class="qty-control-sm">
                                <button class="qty-btn-sm" onclick="changeQty('<%= item._id %>', -1)">
                                    <i class="fa-solid fa-minus"></i>
                                </button>
                                <span class="qty-num" id="qty-<%= item._id %>"><%= item.quantity %></span>
                                <button class="qty-btn-sm" onclick="changeQty('<%= item._id %>', 1)">
                                    <i class="fa-solid fa-plus"></i>
                                </button>
                            </div>
                        </td>
                        <td class="cart-price-cell" id="price-<%= item._id %>">
                            ₹<%= item.price.toLocaleString('en-IN') %>
                        </td>
                        <td style="padding:20px 0 20px 16px; text-align:right;">
                            <button class="cart-remove" onclick="removeItem('<%= item._id %>')" title="Remove">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <!-- Summary -->
        <div class="order-summary-card animate-up delay-2">
            <div class="summary-title">Order Summary</div>

            <div class="summary-row">
                <span class="summary-label">Subtotal</span>
                <span class="summary-val" id="summarySubtotal">₹<%= totalPrice.toLocaleString('en-IN') %></span>
            </div>
            <div class="summary-row">
                <span class="summary-label">Shipping</span>
                <span class="summary-val" style="color:#6dbf7f;">Free</span>
            </div>
            <div class="summary-row">
                <span class="summary-label">Taxes</span>
                <span class="summary-val" style="color:var(--text-muted);">Included</span>
            </div>

            <div class="gold-divider" style="margin:20px 0;"></div>

            <div class="summary-total">
                <div class="summary-total-label">Total</div>
                <div class="summary-total-val" id="summaryTotal">₹<%= totalPrice.toLocaleString('en-IN') %></div>
            </div>

            <a href="/checkout" class="btn-gold-fill" style="width:100%; justify-content:center; padding:16px; display:flex; text-decoration:none;">
                <span>Proceed to Checkout</span>
                <i class="fa-solid fa-arrow-right"></i>
            </a>

            <div style="margin-top:16px; text-align:center; font-size:11px; color:var(--text-muted); display:flex; align-items:center; justify-content:center; gap:8px;">
                <i class="fa-solid fa-lock" style="color:var(--gold);"></i>
                Secure & encrypted checkout
            </div>
        </div>
    </div>

    <% } else { %>
    <div class="cart-empty animate-up">
        <i class="fa-solid fa-bag-shopping"></i>
        <p>Your cart is empty</p>
        <span>Discover our collection of exceptional timepieces</span>
        <br><br>
        <a href="/shop" class="btn-gold-fill" style="margin-top:24px; text-decoration:none; display:inline-flex; gap:8px; padding:14px 36px;">
            <span>Browse Collection</span>
            <i class="fa-solid fa-arrow-right"></i>
        </a>
    </div>
    <% } %>
</div>

<script>
async function changeQty(itemId, delta) {
    const action = delta > 0 ? 'increment' : 'decrement';
    const res = await fetch(`/${action}/${itemId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' }
    });
    const data = await res.json();
    if (res.ok && (data.success || data.status === true)) {
        location.reload();
    } else if (data.message) {
        alert(data.message);
    } else {
        alert(data || 'Error updating quantity');
    }
}

async function removeItem(itemId) {
    if (!confirm('Remove this item from your cart?')) return;
    const res = await fetch(`/remove/${itemId}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
    });
    const data = await res.json();
    if (data.success || data.status === true) {
        document.getElementById('row-' + itemId)?.remove();
        location.reload();
    } else {
        alert(data.message || 'Error removing item');
    }
}
</script>

<%- include("../../views/partials/user/footer") %>
