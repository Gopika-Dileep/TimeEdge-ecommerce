<%- include("../../views/partials/user/header") %>

<link rel="stylesheet" href="/css/orders.css">

<div class="te-container profile-page">
    <div class="animate-up">
        <span class="section-label">Your Dashboard</span>
        <h1 class="section-title">My <em>Orders</em></h1>
    </div>

    <div class="profile-layout">
        <!-- Sidebar Navigation -->
        <%- include("../../views/partials/user/profile-sidebar") %>

        <!-- Profile Panel Contents -->
        <div class="profile-content animate-up delay-2">

            <!-- Order history section -->
            <div class="profile-section">
                <div class="profile-section-title">Order <span>History</span></div>
                <% if (orders && orders.length > 0) { %>
                <div style="overflow-x: auto;">
                    <table class="orders-table">
                        <thead>
                            <tr>
                                <th>Order Reference</th>
                                <th>Placed On</th>
                                <th>Items</th>
                                <th>Total Price</th>
                                <th>Delivery Status</th>
                                <th style="text-align: right; padding-right: 24px !important;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% orders.forEach(order => { %>
                            <tr>
                                <td class="order-id">#<%= (order.orderId || order._id.toString().slice(-8)).toUpperCase() %></td>
                                <td><%= new Date(order.createdOn || order.createdAt).toLocaleDateString('en-IN', {year:'numeric',month:'short',day:'numeric'}) %></td>
                                <td><%= (order.orderedItems || []).length %> Item(s)</td>
                                <td style="color: var(--text-primary); font-weight: 500;">₹<%= (order.finalAmount || 0).toLocaleString('en-IN') %></td>
                                <td>
                                    <span class="order-status status-<%= (order.status || 'pending').toLowerCase() %>">
                                        <%= order.status || 'Pending' %>
                                    </span>
                                </td>
                                <td style="text-align: right; padding-right: 24px !important;">
                                    <a href="/orders-details?id=<%= order._id %>" class="btn-gold" style="padding: 6px 12px; font-size: 10px; text-decoration: none; display: inline-block;">View</a>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
                <% } else { %>
                <div style="text-align: center; padding: 60px 20px;">
                    <i class="fa-solid fa-bag-shopping" style="font-size: 44px; color: var(--text-muted); margin-bottom: 20px; display: block;"></i>
                    <p style="font-family: 'Playfair Display', serif; font-size: 1.2rem; color: var(--text-secondary); margin-bottom: 16px;">No orders found yet</p>
                    <a href="/shop" class="btn-gold-fill" style="text-decoration: none;"><span>Start Shopping</span></a>
                </div>
                <% } %>
            </div>

        </div>
    </div>
</div>

<%- include("../../views/partials/user/footer") %>
