<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify OTP — TimeEdge</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        :root { --bg-primary:#080808; --bg-secondary:#111111; --gold:#c9a84c; --gold-light:#e8c96d; --gold-glow:rgba(201,168,76,0.12); --text-primary:#f0ede8; --text-secondary:#a09484; --text-muted:#5a5248; --border:rgba(201,168,76,0.2); --transition:all 0.35s cubic-bezier(0.4,0,0.2,1); }
        *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
        body { background:var(--bg-primary); color:var(--text-primary); font-family:'Inter',sans-serif; min-height:100vh; display:flex; align-items:center; justify-content:center; padding:40px 20px; }
        .otp-card { width:100%; max-width:460px; background:var(--bg-secondary); border:1px solid var(--border); padding:60px 52px; text-align:center; }
        .otp-logo { font-family:'Playfair Display',serif; font-size:18px; font-weight:700; letter-spacing:3px; text-transform:uppercase; color:var(--text-primary); text-decoration:none; display:block; margin-bottom:40px; }
        .otp-logo span { color:var(--gold); }
        .otp-icon { width:64px; height:64px; border:1px solid var(--border); border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 24px; color:var(--gold); font-size:24px; }
        .otp-title { font-family:'Playfair Display',serif; font-size:1.8rem; font-weight:400; color:var(--text-primary); margin-bottom:10px; }
        .otp-sub { font-size:13px; color:var(--text-secondary); line-height:1.6; margin-bottom:36px; }
        .otp-inputs { display:flex; gap:10px; justify-content:center; margin-bottom:28px; }
        .otp-digit { width:52px; height:58px; text-align:center; font-size:22px; font-weight:500; background:rgba(255,255,255,0.03); border:1px solid var(--border); color:var(--text-primary); font-family:'Playfair Display',serif; outline:none; transition:var(--transition); border-bottom:2px solid rgba(201,168,76,0.3); }
        .otp-digit:focus { border-color:var(--gold); background:var(--gold-glow); }
        .btn-submit { width:100%; padding:15px; background:var(--gold); border:none; color:#080808; font-family:'Inter',sans-serif; font-size:11px; font-weight:600; letter-spacing:3px; text-transform:uppercase; cursor:pointer; transition:var(--transition); }
        .btn-submit:hover { background:var(--gold-light); box-shadow:0 0 30px rgba(201,168,76,0.3); }
        .resend-row { margin-top:24px; font-size:12px; color:var(--text-muted); }
        .resend-btn { background:none; border:none; color:var(--gold); cursor:pointer; font-size:12px; font-family:'Inter',sans-serif; }
        .auth-alert { padding:13px 16px; background:rgba(201,60,60,0.08); border:1px solid rgba(201,60,60,0.25); color:#e07070; font-size:12px; margin-bottom:24px; display:flex; align-items:center; gap:10px; text-align:left; }
    </style>
</head>
<body>
<div class="otp-card">
    <a href="/" class="otp-logo"><span>TIME</span> EDGE</a>
    <div class="otp-icon"><i class="fa-solid fa-key"></i></div>
    <h1 class="otp-title">Enter OTP</h1>
    <p class="otp-sub">Enter the 6-digit code sent to <strong style="color:var(--gold);"><%= typeof email !== 'undefined' ? email : 'your email' %></strong></p>

    <% if (typeof message !== 'undefined' && message) { %>
    <div class="auth-alert" id="authAlert"><i class="fa-solid fa-circle-exclamation"></i><span id="authAlertText"><%= message %></span></div>
    <% } else { %>
    <div class="auth-alert" id="authAlert" style="display:none;"><i class="fa-solid fa-circle-exclamation"></i><span id="authAlertText"></span></div>
    <% } %>

    <div class="otp-inputs">
        <input type="text" class="otp-digit" maxlength="1" id="d1" autofocus oninput="this.value = this.value.replace(/[^0-9]/g, '')">
        <input type="text" class="otp-digit" maxlength="1" id="d2" oninput="this.value = this.value.replace(/[^0-9]/g, '')">
        <input type="text" class="otp-digit" maxlength="1" id="d3" oninput="this.value = this.value.replace(/[^0-9]/g, '')">
        <input type="text" class="otp-digit" maxlength="1" id="d4" oninput="this.value = this.value.replace(/[^0-9]/g, '')">
        <input type="text" class="otp-digit" maxlength="1" id="d5" oninput="this.value = this.value.replace(/[^0-9]/g, '')">
        <input type="text" class="otp-digit" maxlength="1" id="d6" oninput="this.value = this.value.replace(/[^0-9]/g, '')">
    </div>

    <button class="btn-submit" onclick="submitForgotOtp()">
        Verify OTP &nbsp; <i class="fa-solid fa-arrow-right"></i>
    </button>

    <div class="resend-row">
        Didn't receive it?
        <span id="timerText"> Resend in <span id="countdown">60</span>s</span>
        <button class="resend-btn" id="resendBtn" style="display:none;" onclick="resendOtp()">Resend OTP</button>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
const digits = document.querySelectorAll('.otp-digit');
const emailAddr = '<%= typeof email !== "undefined" ? email : "" %>';

digits.forEach((d, i) => {
    d.addEventListener('input', () => { if (d.value && i < 5) digits[i+1].focus(); });
    d.addEventListener('keydown', e => { if (e.key === 'Backspace' && !d.value && i > 0) digits[i-1].focus(); });
});

function getOtp() { return Array.from(digits).map(d => d.value).join(''); }

function displayError(msg) {
    const alertEl = document.getElementById('authAlert');
    const textEl = document.getElementById('authAlertText');
    textEl.textContent = msg;
    alertEl.style.display = 'flex';
}

async function submitForgotOtp() {
    const otp = getOtp();
    if (otp.length < 6) {
        return displayError('Please enter all 6 digits.');
    }
    const res = await fetch('/verify-passForgot-otp', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ otp, email: emailAddr })
    });
    const data = await res.json();
    if (data.success) {
        window.location.href = data.redirectUrl;
    } else {
        displayError(data.message || 'Invalid OTP. Please try again.');
    }
}

async function resendOtp() {
    const res = await fetch('/resend-forgot-otp', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ email: emailAddr })
    });
    const data = await res.json();
    if (res.ok && (data.success || data.status === true)) {
        Swal.fire({
            icon: 'success',
            title: 'OTP Sent',
            text: 'New OTP sent successfully!',
            confirmButtonColor: '#c9a84c'
        });
        restartTimer();
    } else {
        displayError(data.message || 'Error resending OTP.');
    }
}

let secs = 60;
const cdown = document.getElementById('countdown');
let interval = setInterval(tick, 1000);
function tick() {
    secs--;
    if (cdown) cdown.textContent = secs;
    if (secs <= 0) {
        clearInterval(interval);
        document.getElementById('timerText').style.display = 'none';
        document.getElementById('resendBtn').style.display = 'inline';
    }
}
function restartTimer() {
    secs = 60; clearInterval(interval);
    document.getElementById('timerText').style.display = 'inline';
    document.getElementById('resendBtn').style.display = 'none';
    interval = setInterval(tick, 1000);
}
</script>
</body>
</html>
