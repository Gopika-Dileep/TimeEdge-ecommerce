<%-include("../../views/partials/user/header") %>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/profile.css">
    
    <div class="te-container profile-page">
        <div class="animate-up">
            <span class="section-label">Your Dashboard</span>
            <h1 class="section-title">My <em>Wishlist</em></h1>
        </div>
    
        <div class="profile-layout">
            <!-- Sidebar Navigation -->
            <%- include("../../views/partials/user/profile-sidebar") %>
    
            <!-- Profile Panel Contents -->
            <div class="profile-content animate-up delay-2" style="width: 100%;">
                <div class="profile-section" style="background: var(--bg-card); border: 1px solid var(--border); padding: 40px;">
                    <div class="profile-section-title">My <span>Wishlist</span></div>
                    
                    <% if (wishlist && wishlist.products && wishlist.products.length > 0) { %>
                        <div class="products-grid">
                            <% wishlist.products.forEach(product => { %>
                                <div class="product-card" style="background: var(--bg-primary); border: 1px solid var(--border);">
                                    <div class="product-image">
                                        <a href="/productDetails?id=<%= product.productId._id %>">
                                            <img src="<%= product.productId.productImage && product.productId.productImage.length > 0 ? '/uploads/productImages/' + product.productId.productImage[0] : '/uploads/productImages/default.png' %>"
                                                alt="<%= product.productId.productName %>" />
                                        </a>
                                        <button class="remove-btn" onclick="removeItem('<%= product.productId._id %>')">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                    <div class="product-info" style="background: var(--bg-card); border-top: 1px solid var(--border);">
                                        <h3 class="product-name" style="color: var(--text-primary);">
                                            <%= product.productId.productName %>
                                        </h3>
                                        <div class="product-details">
                                            <span class="price" style="color: var(--text-primary);">₹<%= product.finalPrice %></span>
                                            <% if (product.productId.quantity > 0) { %>
                                            <span class="status available">In Stock</span>
                                            <% } else { %>
                                            <span class="status unavailable">Out of Stock</span>
                                            <% } %>
                                        </div>
                                        <% if (product.productId.quantity > 0) { %>
                                        <button class="add-cart-btn" onclick="addToCart('<%= product.productId._id %>', 1)" style="background: var(--gold); color: #080808; border-radius: 0;">
                                            Add to Cart
                                        </button>
                                        <% } else { %>
                                        <button class="add-cart-btn" disabled style="background: var(--border); color: var(--text-muted); border-radius: 0; cursor: not-allowed;">
                                            Out of Stock
                                        </button>
                                        <% } %>
                                    </div>
                                </div>
                            <% }) %>
                        </div>

                        <% if (totalPages > 1) { %>
                        <div class="pagination-container" style="display: flex; justify-content: center; gap: 8px; margin-top: 40px;">
                            <% if (hasPrevPage) { %>
                                <a href="/wishlist?page=<%= currentPage - 1 %>" class="pagination-link">&laquo;</a>
                            <% } %>
                            <% for (let i = 1; i <= totalPages; i++) { %>
                                <a href="/wishlist?page=<%= i %>" class="pagination-link <%= i === currentPage ? 'active' : '' %>"><%= i %></a>
                            <% } %>
                            <% if (hasNextPage) { %>
                                <a href="/wishlist?page=<%= currentPage + 1 %>" class="pagination-link">&raquo;</a>
                            <% } %>
                        </div>
                        <% } %>

                    <% } else { %>
                        <div class="empty-wishlist" style="background: var(--bg-card); color: var(--text-primary); border: none; text-align: center;">
                            <div class="empty-icon" style="color: var(--gold);">
                                <i class="fas fa-heart"></i>
                            </div>
                            <h2 style="color: var(--text-primary);">Your Wishlist is Empty</h2>
                            <p style="color: var(--text-secondary);">Save your favorite items to purchase them later</p>
                            <a href="/shop" class="shop-now-btn" style="background: var(--gold); color: #080808; border-radius: 0;">Start Shopping</a>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function removeItem(itemId) {
            Swal.fire({
                title: 'Remove Item?',
                text: 'This item will be removed from your wishlist',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#757575',
                confirmButtonText: 'Yes, remove it',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: `/removeitem/${itemId}`,
                        method: 'POST',
                        success: function (response) {
                            if (response.success) {
                                Swal.fire({
                                    title: 'Removed!',
                                    text: 'Item removed from wishlist',
                                    icon: 'success',
                                    showConfirmButton: false,
                                    timer: 1500
                                }).then(() => {
                                    location.reload();
                                });
                            }
                        },
                        error: function (xhr) {
                            if (xhr.status === 401 || (xhr.responseJSON && xhr.responseJSON.notLoggedIn)) {
                                Swal.fire({
                                    icon: 'info',
                                    title: 'Login Required',
                                    text: 'Please login to manage your wishlist',
                                    showCancelButton: true,
                                    confirmButtonText: 'Go to Login',
                                    cancelButtonText: 'Cancel',
                                    confirmButtonColor: '#7066e0',
                                    cancelButtonColor: '#6c757d'
                                }).then((result) => {
                                    if (result.isConfirmed) {
                                        window.location.href = '/login';
                                    }
                                });
                                return;
                            }
                            Swal.fire('Error', 'Could not remove item', 'error');
                        }
                    });
                }
            });
        }

        function addToCart(productId, quantity) {
            $.ajax({
                url: `/addToCart/${productId}`,
                method: 'POST',
                data: JSON.stringify({ quantity }),
                contentType: 'application/json',
                success: function (response) {
                    if (response.cartCount !== undefined) {
                        $('#cartCount').text(response.cartCount);
                    }
                    Swal.fire({
                        title: 'Added to Cart!',
                        text: 'Would you like to view your cart?',
                        icon: 'success',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#757575',
                        confirmButtonText: 'View Cart',
                        cancelButtonText: 'Continue Shopping'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = '/cart';
                        }
                    });
                },
                error: function (xhr) {
                    if (xhr.status === 401 || (xhr.responseJSON && xhr.responseJSON.notLoggedIn)) {
                        Swal.fire({
                            icon: 'info',
                            title: 'Login Required',
                            text: 'Please login to manage your wishlist',
                            showCancelButton: true,
                            confirmButtonText: 'Go to Login',
                            cancelButtonText: 'Cancel',
                            confirmButtonColor: '#7066e0',
                            cancelButtonColor: '#6c757d'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                window.location.href = '/login';
                            }
                        });
                        return;
                    }
                    const message = xhr.responseJSON?.message || 'Could not add to cart. Please try again.';
                    Swal.fire({
                        icon: 'error',
                        title: 'Oops...',
                        text: message,
                        confirmButtonColor: '#c9a84c'
                    });
                }
            });
        }
    </script>

    <%-include("../../views/partials/user/footer") %>