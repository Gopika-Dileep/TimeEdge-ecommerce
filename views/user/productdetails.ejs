<%- include("../../views/partials/user/header") %>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

<style>
/* Product Details Page */
.pd-hero { padding: 40px 0 80px; }
.breadcrumb-te { display:flex; align-items:center; gap:10px; font-size:11px; letter-spacing:1.5px; text-transform:uppercase; color:var(--text-muted); margin-bottom:48px; }
.breadcrumb-te a { color:var(--text-muted); text-decoration:none; transition:color 0.3s; }
.breadcrumb-te a:hover { color:var(--gold); }
.breadcrumb-te i { font-size:8px; }

.pd-layout { display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:start; }

/* Gallery */
.pd-gallery { position:sticky; top:100px; }
.pd-main-img {
    aspect-ratio:1/1; overflow:hidden;
    background:var(--bg-card);
    border:1px solid var(--border);
    margin-bottom:16px;
    position:relative;
    display:flex;
    align-items:center;
    justify-content:center;
}
.pd-main-img img {
    width:100%; height:100%; object-fit:cover;
    transition:transform 0.6s cubic-bezier(0.4,0,0.2,1);
}
.pd-main-img:hover img { transform:scale(1.05); }
.pd-thumbs { display:grid; grid-template-columns:repeat(4,1fr); gap:10px; }
.pd-thumb {
    aspect-ratio:1/1; overflow:hidden;
    background:var(--bg-card); border:1px solid var(--border);
    cursor:pointer; transition:border-color 0.3s;
}
.pd-thumb img { width:100%; height:100%; object-fit:cover; }
.pd-thumb:hover, .pd-thumb.active { border-color:var(--gold); }

/* Product Info */
.pd-info { }
.pd-brand { font-size:11px; letter-spacing:3px; text-transform:uppercase; color:var(--gold); margin-bottom:14px; }
.pd-name {
    font-family:'Playfair Display',serif;
    font-size:clamp(1.8rem,3vw,2.8rem);
    font-weight:400; color:var(--text-primary); line-height:1.2; margin-bottom:20px;
}
.pd-divider { width:48px; height:1px; background:linear-gradient(90deg,transparent,var(--gold),transparent); margin-bottom:24px; }

/* Price */
.pd-price-block { display:flex; align-items:baseline; gap:16px; margin-bottom:28px; }
.pd-price { font-family:'Playfair Display',serif; font-size:2rem; font-weight:500; color:var(--text-primary); }
.pd-price-old { font-size:1.1rem; color:var(--text-muted); text-decoration:line-through; }
.pd-offer-badge {
    padding:4px 12px; background:var(--gold-glow);
    border:1px solid rgba(201,168,76,0.3);
    font-size:10px; letter-spacing:1.5px; text-transform:uppercase; color:var(--gold);
}
.pd-savings { font-size:12px; color:#6dbf7f; margin-bottom:24px; display:flex; align-items:center; gap:8px; }

/* Specs */
.pd-specs { margin-bottom:32px; }
.pd-spec-row {
    display:flex; align-items:center; justify-content:space-between;
    padding:12px 0; border-bottom:1px solid var(--border);
}
.pd-spec-key { font-size:11px; letter-spacing:1.5px; text-transform:uppercase; color:var(--text-muted); }
.pd-spec-val { font-size:13px; color:var(--text-secondary); }

/* Stock */
.pd-stock { display:flex; align-items:center; gap:8px; font-size:12px; margin-bottom:28px; }
.stock-dot { width:8px; height:8px; border-radius:50%; }
.stock-dot.in { background:#4caf50; box-shadow:0 0 8px rgba(76,175,80,0.4); }
.stock-dot.out { background:#e57373; }

/* Qty */
.pd-qty-wrap { display:flex; align-items:center; gap:20px; margin-bottom:32px; }
.qty-label { font-size:10px; letter-spacing:2px; text-transform:uppercase; color:var(--text-secondary); }
.qty-control {
    display:flex; align-items:center; gap:0;
    border:1px solid var(--border);
}
.qty-btn {
    width:44px; height:44px; background:transparent; border:none;
    color:var(--text-secondary); font-size:16px; cursor:pointer;
    transition:var(--transition); display:flex; align-items:center; justify-content:center;
}
.qty-btn:hover { color:var(--gold); background:var(--gold-glow); }
.qty-val { width:52px; text-align:center; font-size:16px; font-weight:500; color:var(--text-primary); line-height:44px; border-left:1px solid var(--border); border-right:1px solid var(--border); }

/* CTA */
.pd-cta { display:flex; gap:12px; margin-bottom:32px; flex-wrap:wrap; align-items:center; }
.pd-cta .btn-gold-fill { flex:1; min-width:200px; justify-content:center; padding:16px; }
.pd-cta .btn-wishlist {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--gold);
    width: 54px;
    height: 54px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    cursor: pointer;
    transition: var(--transition);
}
.pd-cta .btn-wishlist:hover {
    border-color: var(--gold);
    background: var(--gold-glow);
    transform: translateY(-2px);
}
.pd-cta .btn-wishlist i {
    font-size: 20px;
    transition: transform 0.3s ease;
}
.pd-cta .btn-wishlist:hover i {
    transform: scale(1.15);
}

/* Guarantees */
.pd-guarantees { display:flex; flex-direction:column; gap:14px; padding:24px; background:var(--bg-card); border:1px solid var(--border); }
.pd-guarantee { display:flex; align-items:center; gap:12px; }
.pd-guarantee i { color:var(--gold); font-size:14px; width:18px; }
.pd-guarantee span { font-size:12px; color:var(--text-secondary); letter-spacing:0.3px; }

/* Description tabs */
.pd-tabs-section { margin-top:80px; padding-top:60px; border-top:1px solid var(--border); }
.pd-tabs { display:flex; gap:0; border-bottom:1px solid var(--border); margin-bottom:40px; }
.pd-tab {
    padding:14px 28px; font-size:10px; letter-spacing:2.5px;
    text-transform:uppercase; color:var(--text-muted);
    cursor:pointer; border-bottom:1px solid transparent;
    transition:var(--transition); background:none; border-top:none; border-left:none; border-right:none;
    font-family:'Inter',sans-serif; margin-bottom:-1px;
}
.pd-tab:hover { color:var(--text-secondary); }
.pd-tab.active { color:var(--gold); border-bottom-color:var(--gold); }
.pd-tab-content { display:none; font-size:14px; color:var(--text-secondary); line-height:1.9; }
.pd-tab-content.active { display:block; }

/* Image Zoom Effect */
.pd-main-img {
    position: relative;
    overflow: hidden;
    cursor: zoom-in;
}
.pd-main-img img {
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transition: transform 0.1s ease-out;
    transform-origin: center center;
}

/* Related Products Section */
.related-section {
    margin-top: 80px;
    padding-top: 60px;
    border-top: 1px solid var(--border);
    animation: fadeInUp 0.8s ease;
}

.related-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.8rem;
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: 32px;
}

.related-title em {
    font-style: italic;
    color: var(--gold);
}

.related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
}

.related-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 24px;
    transition: var(--transition);
    text-align: center;
    position: relative;
    overflow: hidden;
}

.related-card:hover {
    border-color: var(--gold);
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(201,168,76,0.05);
}

.related-img-container {
    height: 220px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-secondary);
    border-radius: 6px;
    margin-bottom: 20px;
    overflow: hidden;
}

.related-img-container img {
    max-height: 80%;
    max-width: 80%;
    object-fit: contain;
    transition: transform 0.5s ease;
}

.related-card:hover .related-img-container img {
    transform: scale(1.08);
}

.related-brand {
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 6px;
}

.related-name {
    font-family: 'Playfair Display', serif;
    font-size: 1.1rem;
    color: var(--text-primary);
    margin-bottom: 12px;
    text-decoration: none;
    display: block;
}

.related-price {
    font-size: 14px;
    font-weight: 500;
    color: var(--gold);
}

@media (max-width:1024px) { .pd-layout { grid-template-columns:1fr; gap:48px; } .pd-gallery { position:static; } }
@media (max-width:768px) { .related-grid { grid-template-columns: 1fr; } }
@media (max-width:600px) { .pd-cta { flex-direction:column; } .pd-thumbs { grid-template-columns:repeat(4,1fr); } }
</style>

<div class="te-container pd-hero">
    <!-- Breadcrumb -->
    <div class="breadcrumb-te animate-up">
        <a href="/">Home</a>
        <i class="fa-solid fa-chevron-right"></i>
        <a href="/shop">Collections</a>
        <i class="fa-solid fa-chevron-right"></i>
        <span style="color:var(--text-secondary);"><%= product.productName %></span>
    </div>

    <div class="pd-layout">
        <!-- Gallery -->
        <div class="pd-gallery animate-fade">
            <div class="pd-main-img">
                <img id="mainImg" src="/uploads/productImages/<%= product.productImage[0] %>" alt="<%= product.productName %>">
            </div>
            <div class="pd-thumbs">
                <% product.productImage.forEach((img, idx) => { %>
                <div class="pd-thumb <%= idx === 0 ? 'active' : '' %>" onclick="switchImg('<%= img %>', this)">
                    <img src="/uploads/productImages/<%= img %>" alt="<%= product.productName %> view <%= idx+1 %>">
                </div>
                <% }) %>
            </div>
        </div>

        <!-- Info -->
        <div class="pd-info animate-up">
            <div class="pd-brand"><%= product.brand ? product.brand.brandName : '' %></div>
            <h1 class="pd-name"><%= product.productName %></h1>
            <div class="pd-divider"></div>

            <!-- Price -->
            <div class="pd-price-block">
                <span class="pd-price">₹<%= product.salePrice.toLocaleString('en-IN') %></span>
                <% if (product.regularPrice > product.salePrice) { %>
                <span class="pd-price-old">₹<%= product.regularPrice.toLocaleString('en-IN') %></span>
                <% if (product.productOffer > 0) { %>
                <span class="pd-offer-badge"><%= product.productOffer %>% OFF</span>
                <% } %>
                <% } %>
            </div>
            <% if (product.regularPrice > product.salePrice) { %>
            <div class="pd-savings">
                <i class="fa-solid fa-tag"></i>
                You save ₹<%= (product.regularPrice - product.salePrice).toLocaleString('en-IN') %>
            </div>
            <% } %>

            <!-- Specs -->
            <div class="pd-specs">
                <div class="pd-spec-row">
                    <span class="pd-spec-key">Brand</span>
                    <span class="pd-spec-val"><%= product.brand ? product.brand.brandName : '' %></span>
                </div>
                <div class="pd-spec-row">
                    <span class="pd-spec-key">Color</span>
                    <span class="pd-spec-val"><%= product.color %></span>
                </div>
                <div class="pd-spec-row">
                    <span class="pd-spec-key">Availability</span>
                    <span class="pd-spec-val"><%= product.quantity > 0 ? 'In Stock' : 'Out of Stock' %></span>
                </div>
                <div class="pd-spec-row">
                    <span class="pd-spec-key">Status</span>
                    <span class="pd-spec-val"><%= product.status %></span>
                </div>
            </div>

            <!-- Stock -->
            <div class="pd-stock">
                <span class="stock-dot <%= product.quantity > 0 ? 'in' : 'out' %>"></span>
                <span style="color:var(--text-secondary); font-size:12px; letter-spacing:0.5px;">
                    <%= product.quantity > 0 ? `${product.quantity} units available` : 'Currently out of stock' %>
                </span>
            </div>

            <!-- Quantity -->
            <div class="pd-qty-wrap">
                <span class="qty-label">Quantity</span>
                <div class="qty-control">
                    <button class="qty-btn" onclick="changeQty(-1)"><i class="fa-solid fa-minus"></i></button>
                    <span class="qty-val" id="qtyDisplay">1</span>
                    <button class="qty-btn" onclick="changeQty(1)"><i class="fa-solid fa-plus"></i></button>
                </div>
                <span style="font-size:11px; color:var(--text-muted);">Max <%= product.maxQtyPerPerson %> per order</span>
            </div>

            <!-- CTA -->
            <div class="pd-cta">
                <button class="btn-gold-fill" id="addToCartBtn" onclick="addToCart()">
                    <i class="fa-solid fa-bag-shopping"></i>
                    <span>Add to Cart</span>
                </button>
                <button class="btn-wishlist" id="wishlistBtn" onclick="toggleWishlist()" title="Add to Wishlist">
                    <i class="bi <%= locals.isInWishlist ? 'bi-heart-fill text-danger' : 'bi-heart' %>" id="wishlistIcon"></i>
                </button>
            </div>

            <!-- Guarantees -->
            <div class="pd-guarantees">
                <div class="pd-guarantee">
                    <i class="fa-solid fa-shield-halved"></i>
                    <span>Certified authentic — verified by our horologists</span>
                </div>
                <div class="pd-guarantee">
                    <i class="fa-solid fa-rotate-left"></i>
                    <span>30-day hassle-free returns</span>
                </div>
                <div class="pd-guarantee">
                    <i class="fa-solid fa-truck-fast"></i>
                    <span>Insured express delivery nationwide</span>
                </div>
                <div class="pd-guarantee">
                    <i class="fa-solid fa-wrench"></i>
                    <span>1-year manufacturer warranty</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Description Tabs -->
    <div class="pd-tabs-section">
        <div class="pd-tabs">
            <button class="pd-tab active" onclick="switchTab(this,'desc')">Description</button>
            <button class="pd-tab" onclick="switchTab(this,'spec')">Specifications</button>
            <button class="pd-tab" onclick="switchTab(this,'ship')">Shipping & Returns</button>
        </div>
        <div class="pd-tab-content active" id="tab-desc">
            <p><%= product.description %></p>
        </div>
        <div class="pd-tab-content" id="tab-spec">
            <div style="display:grid; grid-template-columns:repeat(2,1fr); gap:16px; max-width:600px;">
                <div class="pd-spec-row"><span class="pd-spec-key">Brand</span><span class="pd-spec-val"><%= product.brand ? product.brand.brandName : '' %></span></div>
                <div class="pd-spec-row"><span class="pd-spec-key">Color</span><span class="pd-spec-val"><%= product.color %></span></div>
                <div class="pd-spec-row"><span class="pd-spec-key">Stock</span><span class="pd-spec-val"><%= product.quantity %> units</span></div>
                <div class="pd-spec-row"><span class="pd-spec-key">Status</span><span class="pd-spec-val"><%= product.status %></span></div>
            </div>
        </div>
        <div class="pd-tab-content" id="tab-ship">
            <p>We offer insured express delivery across India within 3–7 business days. Returns accepted within 30 days of delivery in original condition with packaging. Refunds processed within 5–7 business days.</p>
        </div>
    </div>

    <!-- Related Products -->
    <% if (locals.relatedProducts && relatedProducts.length > 0) { %>
    <div class="related-section">
        <h3 class="related-title">Related <em>Timepieces</em></h3>
        <div class="related-grid">
            <% relatedProducts.forEach(rel => { %>
            <div class="related-card">
                <a href="/productDetails?id=<%= rel._id %>" style="text-decoration:none;">
                    <div class="related-img-container">
                        <img src="/uploads/productImages/<%= rel.productImage[0] %>" alt="<%= rel.productName %>">
                    </div>
                    <div class="related-brand"><%= rel.brand ? rel.brand.brandName : '' %></div>
                    <span class="related-name"><%= rel.productName %></span>
                    <div class="related-price">₹<%= rel.salePrice.toLocaleString('en-IN') %></div>
                </a>
            </div>
            <% }) %>
        </div>
    </div>
    <% } %>
</div>

<script>
const maxQty = Number('<%= product.maxQtyPerPerson || 5 %>');
const productId = '<%= product._id %>';
let qty = 1;

function changeQty(d) {
    qty = Math.min(Math.max(1, qty + d), maxQty);
    document.getElementById('qtyDisplay').textContent = qty;
}

function switchImg(img, el) {
    document.getElementById('mainImg').src = '/uploads/productImages/' + img;
    document.querySelectorAll('.pd-thumb').forEach(t => t.classList.remove('active'));
    el.classList.add('active');
}

function switchTab(btn, tab) {
    document.querySelectorAll('.pd-tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.pd-tab-content').forEach(t => t.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('tab-' + tab).classList.add('active');
}

async function addToCart() {
    const btn = document.getElementById('addToCartBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> <span>Adding...</span>';

    try {
        const res = await fetch('/addToCart/' + productId, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ quantity: qty })
        });
        if (res.ok) {
            const data = await res.json();
            if (data.cartCount !== undefined) {
                const countBadge = document.getElementById('cartCount');
                if (countBadge) {
                    countBadge.innerText = data.cartCount;
                }
            }
            btn.innerHTML = '<i class="fa-solid fa-check"></i> <span>Added!</span>';
            btn.style.background = '#4caf50';
            setTimeout(() => {
                btn.innerHTML = '<i class="fa-solid fa-bag-shopping"></i> <span>Add to Cart</span>';
                btn.style.background = '';
                btn.disabled = false;
            }, 1800);
        } else {
            btn.innerHTML = '<i class="fa-solid fa-bag-shopping"></i> <span>Add to Cart</span>';
            btn.disabled = false;
            const data = await res.json();
            Swal.fire({
                icon: 'error',
                title: 'Add to Cart Failed',
                text: data.message || 'Could not add to cart. Please try again.',
                confirmButtonColor: '#c9a84c'
            });
        }
    } catch(e) {
        btn.innerHTML = '<i class="fa-solid fa-bag-shopping"></i> <span>Add to Cart</span>';
        btn.disabled = false;
    }
}
</script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>

async function toggleWishlist() {
    try {
        const isUserLoggedIn = '<%= locals.user ? "true" : "false" %>' === 'true';
        if (!isUserLoggedIn) {
            Swal.fire({
                title: 'Login Required',
                text: 'Please login to add products to your wishlist.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#c9a84c',
                cancelButtonColor: '#757575',
                confirmButtonText: 'Login Now',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '/login';
                }
            });
            return;
        }

        const icon = document.getElementById('wishlistIcon');
        const res = await fetch(`/addToWishlist/${productId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ productId })
        });
        const response = await res.json();
        if (response.success) {
            if (response.action === 'added') {
                icon.classList.remove('bi-heart');
                icon.classList.add('bi-heart-fill', 'text-danger');
                Swal.fire({
                    icon: 'success',
                    title: 'Wishlist Updated',
                    text: 'Product added to wishlist.',
                    timer: 1500,
                    showConfirmButton: false
                });
            } else {
                icon.classList.remove('bi-heart-fill', 'text-danger');
                icon.classList.add('bi-heart');
                Swal.fire({
                    icon: 'success',
                    title: 'Wishlist Updated',
                    text: 'Product removed from wishlist.',
                    timer: 1500,
                    showConfirmButton: false
                });
            }
        }
    } catch (e) {
        console.error(e);
    }
}

// Image Zoom Effect
document.addEventListener('DOMContentLoaded', function() {
    const mainImgContainer = document.querySelector('.pd-main-img');
    const mainImg = document.getElementById('mainImg');
    if (mainImgContainer && mainImg) {
        mainImgContainer.addEventListener('mousemove', function(e) {
            const rect = mainImgContainer.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            const xPercent = (x / rect.width) * 100;
            const yPercent = (y / rect.height) * 100;
            mainImg.style.transformOrigin = `${xPercent}% ${yPercent}%`;
            mainImg.style.transform = 'scale(2.2)';
        });
        mainImgContainer.addEventListener('mouseleave', function() {
            mainImg.style.transform = 'scale(1)';
            mainImg.style.transformOrigin = 'center center';
        });
    }
});
</script>

<%- include("../../views/partials/user/footer") %>