<%- include("../../views/partials/user/header") %>

<style>
.profile-page { padding: 60px 0 100px; background-color: var(--bg-primary); }
.profile-layout { display: grid; grid-template-columns: 280px 1fr; gap: 40px; margin-top: 48px; }

/* Sidebar Navigation */
.profile-sidebar { position: sticky; top: 100px; }
.profile-nav-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 24px;
}
.profile-nav-list { list-style: none; display: flex; flex-direction: column; gap: 8px; }
.profile-nav-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    font-size: 12px;
    letter-spacing: 1px;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: var(--transition);
    border: 1px solid transparent;
}
.profile-nav-item i { font-size: 14px; color: var(--text-muted); transition: var(--transition); }
.profile-nav-item:hover, .profile-nav-item.active {
    background: var(--gold-glow);
    color: var(--gold);
    border-color: var(--border);
}
.profile-nav-item:hover i, .profile-nav-item.active i { color: var(--gold); }

/* Main Profile Panel */
.profile-content { min-height: 500px; }
.profile-section {
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 40px;
    animation: fadeIn 0.4s ease;
}
@keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
}

.profile-section-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
    font-weight: 400;
    color: var(--text-primary);
    margin-bottom: 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.profile-section-title span { color: var(--gold); font-style: italic; }

/* Form Fields */
.form-group { margin-bottom: 22px; position: relative; }
.form-label { display: block; font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 10px; }
.form-input { width: 100%; padding: 14px 44px 14px 16px; background: rgba(255,255,255,0.03); border: 1px solid var(--border); color: var(--text-primary); font-family: 'Inter', sans-serif; font-size: 14px; outline: none; transition: var(--transition); }
.form-input:focus { border-color: var(--gold); background: var(--gold-glow); }
.eye-btn { position: absolute; right: 14px; bottom: 14px; background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 14px; }
.auth-alert { padding: 13px 16px; background: rgba(201, 60, 60, 0.08); border: 1px solid rgba(201, 60, 60, 0.25); color: #e07070; font-size: 12px; margin-bottom: 24px; display: flex; align-items: center; gap: 10px; }
.auth-success { padding: 13px 16px; background: rgba(76, 175, 80, 0.08); border: 1px solid rgba(76, 175, 80, 0.25); color: #6dbf7f; font-size: 12px; margin-bottom: 24px; display: flex; align-items: center; gap: 10px; }

@media (max-width: 1024px) {
    .profile-layout { grid-template-columns: 1fr; }
    .profile-sidebar { position: static; }
}
</style>

<div class="te-container profile-page">
    <div class="animate-up">
        <span class="section-label">Your Dashboard</span>
        <h1 class="section-title">Change <em>Password</em></h1>
    </div>

    <div class="profile-layout">
        <!-- Sidebar Navigation -->
        <aside class="profile-sidebar animate-up delay-1">
            <div class="profile-nav-card">
                <ul class="profile-nav-list">
                    <li>
                        <a href="/profile" class="profile-nav-item">
                            <i class="fa-regular fa-user"></i> Account Details
                        </a>
                    </li>
                    <li>
                        <a href="/addresses" class="profile-nav-item">
                            <i class="fa-regular fa-address-card"></i> Saved Addresses
                        </a>
                    </li>
                    <li>
                        <a href="/orders" class="profile-nav-item">
                            <i class="fa-solid fa-bag-shopping"></i> My Orders
                        </a>
                    </li>
                    <li>
                        <a href="/change-password" class="profile-nav-item active">
                            <i class="fa-solid fa-key"></i> Security Settings
                        </a>
                    </li>
                    <li>
                        <a href="/change-email" class="profile-nav-item">
                            <i class="fa-regular fa-envelope"></i> Update Email
                        </a>
                    </li>
                    <li style="margin-top: 20px; border-top: 1px solid var(--border); padding-top: 20px;">
                        <a href="/logout" class="profile-nav-item" style="color: #e07070;">
                            <i class="fa-solid fa-arrow-right-from-bracket" style="color: #e07070;"></i> Logout
                        </a>
                    </li>
                </ul>
            </div>
        </aside>

        <!-- Profile Panel Contents -->
        <div class="profile-content animate-up delay-2">

            <!-- Change Password Form -->
            <div class="profile-section">
                <div class="profile-section-title">Update <span>Password</span></div>

                <% if (typeof message !== 'undefined' && message) { %>
                <div class="auth-alert"><i class="fa-solid fa-circle-exclamation"></i><span><%= message %></span></div>
                <% } %>
                <% if (typeof success !== 'undefined' && success) { %>
                <div class="auth-success"><i class="fa-solid fa-circle-check"></i><span><%= success %></span></div>
                <% } %>

                <form action="/change-password" method="POST" style="max-width: 500px;">
                    <div class="form-group">
                        <label class="form-label" for="currentPassword">Current Password</label>
                        <input type="password" class="form-input" id="currentPassword" name="currentPassword" placeholder="••••••••" required>
                        <button type="button" class="eye-btn" onclick="togglePwd('currentPassword')"><i class="fa-regular fa-eye"></i></button>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="newPassword">New Password</label>
                        <input type="password" class="form-input" id="newPassword" name="newPassword" placeholder="Min. 8 characters" required>
                        <button type="button" class="eye-btn" onclick="togglePwd('newPassword')"><i class="fa-regular fa-eye"></i></button>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="confirmPassword">Confirm Password</label>
                        <input type="password" class="form-input" id="confirmPassword" name="confirmPassword" placeholder="Repeat password" required>
                        <button type="button" class="eye-btn" onclick="togglePwd('confirmPassword')"><i class="fa-regular fa-eye"></i></button>
                    </div>
                    <button type="submit" class="btn-gold-fill" style="margin-top: 10px;"><span>Save Password</span></button>
                </form>
            </div>

        </div>
    </div>
</div>

<script>
function togglePwd(id) {
    const f = document.getElementById(id);
    f.type = f.type === 'password' ? 'text' : 'password';
}
</script>

<%- include("../../views/partials/user/footer") %>