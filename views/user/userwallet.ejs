<%- include("../../views/partials/user/header") %>

<link rel="stylesheet" href="/css/profile.css">
<style>
.wallet-balance-card {
    background: rgba(212, 175, 55, 0.03);
    border: 1px solid var(--border);
    padding: 32px;
    margin-bottom: 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.balance-label {
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: 8px;
}
.balance-val {
    font-family: 'Playfair Display', serif;
    font-size: 2.2rem;
    color: var(--gold);
    margin: 0;
}
.wallet-icon-large {
    font-size: 40px;
    color: rgba(212, 175, 55, 0.2);
}
.tx-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
}
.tx-table th {
    padding: 16px 20px;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text-secondary);
    border-bottom: 1px solid var(--border);
    text-align: left;
}
.tx-table td {
    padding: 20px;
    font-size: 13px;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
}
.badge-credit {
    color: #6dbf7f;
    background: rgba(109, 191, 127, 0.08);
    border: 1px solid rgba(109, 191, 127, 0.2);
    padding: 4px 10px;
    font-size: 10px;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-weight: 500;
}
.badge-debit {
    color: #e07070;
    background: rgba(224, 112, 112, 0.08);
    border: 1px solid rgba(224, 112, 112, 0.2);
    padding: 4px 10px;
    font-size: 10px;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-weight: 500;
}
.amt-credit {
    color: #6dbf7f;
    font-weight: 600;
}
.amt-debit {
    color: #e07070;
    font-weight: 600;
}
.pagination-container {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 32px;
}
.pagination-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--border);
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 12px;
    transition: var(--transition);
}
.pagination-link:hover, .pagination-link.active {
    border-color: var(--gold);
    color: var(--gold);
    background: var(--gold-glow);
}
</style>

<div class="te-container profile-page">
    <div class="animate-up">
        <span class="section-label">Your Dashboard</span>
        <h1 class="section-title">My <em>Wallet</em></h1>
    </div>

    <div class="profile-layout">
        <!-- Sidebar Navigation -->
        <%- include("../../views/partials/user/profile-sidebar") %>

        <!-- Profile Panel Contents -->
        <div class="profile-content animate-up delay-2">

            <!-- Wallet Overview -->
            <div class="profile-section">
                <div class="profile-section-title">Wallet <span>Balance</span></div>

                <div class="wallet-balance-card">
                    <div>
                        <div class="balance-label">Current Balance</div>
                        <h2 class="balance-val">₹<%= wallet?.balance ? wallet.balance.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) : '0.00' %></h2>
                    </div>
                    <i class="fa-solid fa-wallet wallet-icon-large"></i>
                </div>

                <div class="profile-section-title">Transaction <span>History</span></div>

                <% if (wallet && wallet.transactions && wallet.transactions.length > 0) { %>
                <div style="overflow-x: auto;">
                    <table class="tx-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Transaction Type</th>
                                <th>Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% wallet.transactions.forEach(transaction => { %>
                            <tr>
                                <td><%= new Date(transaction.date).toLocaleDateString('en-IN', {year:'numeric', month:'short', day:'numeric'}) %></td>
                                <td>
                                    <span class="<%= transaction.type.toLowerCase() === 'credit' ? 'badge-credit' : 'badge-debit' %>">
                                        <%= transaction.type %>
                                    </span>
                                </td>
                                <td class="<%= transaction.type.toLowerCase() === 'credit' ? 'amt-credit' : 'amt-debit' %>">
                                    <%= transaction.type.toLowerCase() === 'credit' ? '+' : '-' %> ₹<%= Math.abs(transaction.amount).toLocaleString('en-IN', {minimumFractionDigits: 2}) %>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <% if (totalpage > 1) { %>
                <div class="pagination-container">
                    <% if (currentpage > 1) { %>
                    <a href="/wallet?page=<%= currentpage - 1 %>" class="pagination-link">&laquo;</a>
                    <% } %>

                    <% for(let i = 1; i <= totalpage; i++) { %>
                    <a href="/wallet?page=<%= i %>" class="pagination-link <%= i === currentpage ? 'active' : '' %>"><%= i %></a>
                    <% } %>

                    <% if (currentpage < totalpage) { %>
                    <a href="/wallet?page=<%= currentpage + 1 %>" class="pagination-link">&raquo;</a>
                    <% } %>
                </div>
                <% } %>

                <% } else { %>
                <div style="text-align: center; padding: 60px 20px;">
                    <i class="fa-solid fa-receipt" style="font-size: 40px; color: var(--text-muted); margin-bottom: 20px; display: block;"></i>
                    <p style="font-family: 'Playfair Display', serif; font-size: 1.1rem; color: var(--text-secondary); margin: 0;">No transactions found in your history.</p>
                </div>
                <% } %>
            </div>

        </div>
    </div>
</div>

<%- include("../../views/partials/user/footer") %>