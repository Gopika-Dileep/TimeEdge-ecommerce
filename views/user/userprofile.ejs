<%- include("../../views/partials/user/header") %>

<link rel="stylesheet" href="/css/profile.css">

<div class="te-container profile-page">
    <div class="animate-up">
        <span class="section-label">Your Dashboard</span>
        <h1 class="section-title">My <em>Account</em></h1>
    </div>

    <div class="profile-layout">
        <!-- Sidebar Navigation -->
        <%- include("../../views/partials/user/profile-sidebar") %>

        <!-- Profile Panel Contents -->
        <div class="profile-content animate-up delay-2">

            <!-- Account details Form -->
            <div class="profile-section">
                <div class="profile-section-title">Personal <span>Details</span></div>
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">Full Name</label>
                        <div class="form-input" style="background: rgba(255,255,255,0.02); display: flex; align-items: center; min-height: 48px; border: 1px solid var(--border); padding: 0 16px; color: var(--text-primary);">
                            <%= user.name %>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Email Address</label>
                        <div class="form-input" style="background: rgba(255,255,255,0.02); display: flex; align-items: center; min-height: 48px; border: 1px solid var(--border); padding: 0 16px; color: var(--text-primary);">
                            <%= user.email %>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Phone Number</label>
                        <div class="form-input" style="background: rgba(255,255,255,0.02); display: flex; align-items: center; min-height: 48px; border: 1px solid var(--border); padding: 0 16px; color: var(--text-primary);">
                            <%= user.phone || 'N/A' %>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Member Since</label>
                        <div class="form-input" style="background: rgba(255,255,255,0.02); display: flex; align-items: center; min-height: 48px; border: 1px solid var(--border); padding: 0 16px; color: var(--text-primary);">
                            <%= new Date(user.createdOn).toLocaleDateString('en-IN', {year:'numeric',month:'long',day:'numeric'}) %>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<%- include("../../views/partials/user/footer") %>