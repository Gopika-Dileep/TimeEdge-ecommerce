<%- include("../../views/partials/user/header") %>

<link rel="stylesheet" href="/css/profile.css">

<div class="te-container profile-page">
    <div class="animate-up">
        <span class="section-label">Your Dashboard</span>
        <h1 class="section-title">My <em>Account</em></h1>
    </div>

    <div class="profile-layout">
        <!-- Sidebar Navigation -->
        <%- include("../../views/partials/user/profile-sidebar") %>

        <!-- Profile Panel Contents -->
        <div class="profile-content animate-up delay-2">

            <!-- Account details Form -->
            <div class="profile-section">
                <div class="profile-section-title" style="display: flex; justify-content: space-between; align-items: center;">
                    <div>Personal <span>Details</span></div>
                    <button class="addr-btn" onclick="toggleEditProfile()" style="color: var(--gold); border: 1px solid var(--border); padding: 8px 16px; font-size: 11px; cursor: pointer;">
                        <i class="fa-solid fa-pen-to-square me-1"></i> Edit Details
                    </button>
                </div>

                <div id="viewProfileBlock">
                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label">Full Name</label>
                            <div class="form-input" style="background: rgba(255,255,255,0.02); display: flex; align-items: center; min-height: 48px; border: 1px solid var(--border); padding: 0 16px; color: var(--text-primary);">
                                <%= user.name %>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Email Address</label>
                            <div class="form-input" style="background: rgba(255,255,255,0.02); display: flex; align-items: center; min-height: 48px; border: 1px solid var(--border); padding: 0 16px; color: var(--text-muted); cursor: not-allowed;">
                                <%= user.email %>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Phone Number</label>
                            <div class="form-input" style="background: rgba(255,255,255,0.02); display: flex; align-items: center; min-height: 48px; border: 1px solid var(--border); padding: 0 16px; color: var(--text-primary);">
                                <%= user.phone || 'N/A' %>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Member Since</label>
                            <div class="form-input" style="background: rgba(255,255,255,0.02); display: flex; align-items: center; min-height: 48px; border: 1px solid var(--border); padding: 0 16px; color: var(--text-muted); cursor: not-allowed;">
                                <%= new Date(user.createdAt).toLocaleDateString('en-IN', {year:'numeric',month:'long',day:'numeric'}) %>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="editProfileBlock" style="display: none; margin-top: 10px;">
                    <form id="editProfileForm" onsubmit="handleProfileUpdate(event)">
                        <div class="form-grid">
                            <div class="form-group">
                                <label class="form-label" style="color: var(--gold);">Full Name *</label>
                                <input type="text" id="editName" name="name" value="<%= user.name %>" required class="form-input" style="background: var(--bg-card); border: 1px solid var(--gold); padding: 12px 16px; color: var(--text-primary); outline: none;" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Email Address (Read-only)</label>
                                <input type="text" value="<%= user.email %>" disabled class="form-input" style="background: rgba(255,255,255,0.02); border: 1px solid var(--border); padding: 12px 16px; color: var(--text-muted); cursor: not-allowed;" />
                            </div>
                            <div class="form-group">
                                <label class="form-label" style="color: var(--gold);">Phone Number *</label>
                                <input type="text" id="editPhone" name="phone" value="<%= user.phone || '' %>" required class="form-input" style="background: var(--bg-card); border: 1px solid var(--gold); padding: 12px 16px; color: var(--text-primary); outline: none;" placeholder="10-digit mobile number" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Member Since (Read-only)</label>
                                <input type="text" value="<%= new Date(user.createdAt).toLocaleDateString('en-IN', {year:'numeric',month:'long',day:'numeric'}) %>" disabled class="form-input" style="background: rgba(255,255,255,0.02); border: 1px solid var(--border); padding: 12px 16px; color: var(--text-muted); cursor: not-allowed;" />
                            </div>
                        </div>
                        <div style="display: flex; gap: 12px; margin-top: 24px;">
                            <button type="submit" class="add-cart-btn" style="background: var(--gold); color: #080808; padding: 10px 24px; font-weight: 600; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; border: none; cursor: pointer;">
                                Save Changes
                            </button>
                            <button type="button" onclick="toggleEditProfile()" style="background: transparent; color: var(--text-muted); border: 1px solid var(--border); padding: 10px 24px; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; cursor: pointer;">
                                Cancel
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
function toggleEditProfile() {
    const viewBlock = document.getElementById('viewProfileBlock');
    const editBlock = document.getElementById('editProfileBlock');
    if (viewBlock.style.display === 'none') {
        viewBlock.style.display = 'block';
        editBlock.style.display = 'none';
    } else {
        viewBlock.style.display = 'none';
        editBlock.style.display = 'block';
    }
}

async function handleProfileUpdate(e) {
    e.preventDefault();
    const name = document.getElementById('editName').value.trim();
    const phone = document.getElementById('editPhone').value.trim();

    if (!name) {
        return Swal.fire({ icon: 'error', title: 'Error', text: 'Full Name cannot be empty', confirmButtonColor: '#c9a84c' });
    }
    if (!/^[0-9]{10}$/.test(phone)) {
        return Swal.fire({ icon: 'error', title: 'Error', text: 'Please enter a valid 10-digit phone number', confirmButtonColor: '#c9a84c' });
    }

    try {
        const res = await fetch('/updateProfile', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, phone })
        });
        const data = await res.json();
        if (data.success) {
            Swal.fire({
                icon: 'success',
                title: 'Success',
                text: data.message,
                confirmButtonColor: '#c9a84c'
            }).then(() => location.reload());
        } else {
            Swal.fire({ icon: 'error', title: 'Error', text: data.message || 'Failed to update profile', confirmButtonColor: '#c9a84c' });
        }
    } catch (err) {
        console.error(err);
        Swal.fire({ icon: 'error', title: 'Error', text: 'An unexpected error occurred', confirmButtonColor: '#c9a84c' });
    }
}
</script>

<%- include("../../views/partials/user/footer") %>