<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Login to TimeEdge — Your luxury watch destination">
    <title>Login — TimeEdge</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        :root {
            --bg-primary: #080808; --bg-secondary: #111111; --bg-card: #161616;
            --gold: #c9a84c; --gold-light: #e8c96d; --gold-glow: rgba(201,168,76,0.12);
            --text-primary: #f0ede8; --text-secondary: #a09484; --text-muted: #5a5248;
            --border: rgba(201,168,76,0.2); --border-hover: rgba(201,168,76,0.55);
            --transition: all 0.35s cubic-bezier(0.4,0,0.2,1);
        }
        *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
        body {
            background: var(--bg-primary);
            color: var(--text-primary);
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
        }
        ::-webkit-scrollbar { width: 4px; }
        ::-webkit-scrollbar-track { background: var(--bg-primary); }
        ::-webkit-scrollbar-thumb { background: var(--gold); }

        /* Split layout */
        .auth-container { display: flex; width: 100%; min-height: 100vh; }

        /* Left panel — imagery */
        .auth-visual {
            flex: 1;
            position: relative;
            overflow: hidden;
            background: #0a0a0a;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 60px;
        }
        .auth-visual-bg {
            position: absolute; inset: 0;
            background:
                linear-gradient(135deg, rgba(201,168,76,0.08) 0%, transparent 50%),
                linear-gradient(to top, rgba(8,8,8,0.95) 0%, rgba(8,8,8,0.3) 60%),
                url('https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=900&auto=format') center/cover;
        }
        .auth-visual-quote {
            position: relative;
            z-index: 2;
        }
        .auth-visual-quote p {
            font-family: 'Playfair Display', serif;
            font-size: 1.6rem;
            font-weight: 400;
            font-style: italic;
            color: var(--text-primary);
            line-height: 1.5;
            margin-bottom: 16px;
        }
        .auth-visual-quote cite {
            font-size: 11px;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: var(--gold);
        }
        .auth-logo {
            position: absolute;
            top: 48px; left: 60px;
            font-family: 'Playfair Display', serif;
            font-size: 20px;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: var(--text-primary);
            text-decoration: none;
            z-index: 2;
        }
        .auth-logo span { color: var(--gold); }

        /* Right panel — form */
        .auth-form-panel {
            width: 500px;
            min-width: 420px;
            background: var(--bg-secondary);
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 80px 60px;
            border-left: 1px solid var(--border);
        }
        .auth-eyebrow {
            font-size: 10px;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: var(--gold);
            margin-bottom: 16px;
        }
        .auth-title {
            font-family: 'Playfair Display', serif;
            font-size: 2.2rem;
            font-weight: 400;
            color: var(--text-primary);
            margin-bottom: 8px;
            line-height: 1.2;
        }
        .auth-title em { font-style: italic; color: var(--gold); }
        .auth-subtitle {
            font-size: 13px;
            color: var(--text-secondary);
            margin-bottom: 44px;
            line-height: 1.6;
        }

        /* Form elements */
        .form-group { margin-bottom: 24px; }
        .form-label {
            display: block;
            font-size: 10px;
            letter-spacing: 2.5px;
            text-transform: uppercase;
            color: var(--text-secondary);
            margin-bottom: 10px;
        }
        .form-input {
            width: 100%;
            padding: 14px 18px;
            background: rgba(255,255,255,0.03);
            border: 1px solid var(--border);
            border-bottom: 1px solid rgba(201,168,76,0.3);
            color: var(--text-primary);
            font-family: 'Inter', sans-serif;
            font-size: 14px;
            outline: none;
            transition: var(--transition);
        }
        .form-input:focus {
            border-color: var(--gold);
            background: var(--gold-glow);
            box-shadow: 0 4px 20px rgba(201,168,76,0.06);
        }
        .form-input::placeholder { color: var(--text-muted); }

        .input-wrap { position: relative; }
        .input-icon {
            position: absolute;
            right: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 14px;
            cursor: pointer;
            transition: color 0.3s;
        }
        .input-icon:hover { color: var(--gold); }

        /* Error alert */
        .auth-alert {
            padding: 13px 16px;
            background: rgba(201,60,60,0.08);
            border: 1px solid rgba(201,60,60,0.25);
            color: #e07070;
            font-size: 12px;
            letter-spacing: 0.3px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* Submit button */
        .btn-submit {
            width: 100%;
            padding: 15px;
            background: var(--gold);
            border: none;
            color: #080808;
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 3px;
            text-transform: uppercase;
            cursor: pointer;
            transition: var(--transition);
            margin-top: 8px;
        }
        .btn-submit:hover {
            background: var(--gold-light);
            box-shadow: 0 0 30px rgba(201,168,76,0.3);
        }

        /* Divider */
        .or-divider {
            display: flex;
            align-items: center;
            gap: 16px;
            margin: 28px 0;
        }
        .or-divider::before, .or-divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: var(--border);
        }
        .or-divider span {
            font-size: 10px;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--text-muted);
        }

        /* Google button */
        .btn-google {
            width: 100%;
            padding: 13px;
            background: transparent;
            border: 1px solid var(--border);
            color: var(--text-secondary);
            font-family: 'Inter', sans-serif;
            font-size: 12px;
            letter-spacing: 1.5px;
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            text-decoration: none;
        }
        .btn-google:hover {
            border-color: var(--gold);
            color: var(--text-primary);
            background: var(--gold-glow);
        }

        .auth-footer {
            margin-top: 32px;
            font-size: 12px;
            color: var(--text-muted);
            text-align: center;
        }
        .auth-footer a {
            color: var(--gold);
            text-decoration: none;
            transition: color 0.3s;
        }
        .auth-footer a:hover { color: var(--gold-light); }

        .forgot-link {
            display: block;
            text-align: right;
            font-size: 11px;
            color: var(--text-muted);
            text-decoration: none;
            margin-top: 6px;
            letter-spacing: 0.5px;
            transition: color 0.3s;
        }
        .forgot-link:hover { color: var(--gold); }

        @media (max-width: 900px) {
            .auth-visual { display: none; }
            .auth-form-panel { width: 100%; min-width: unset; border-left: none; }
        }
        @media (max-width: 480px) {
            .auth-form-panel { padding: 60px 28px; }
        }
    </style>
</head>
<body>
<div class="auth-container">
    <!-- Visual panel -->
    <div class="auth-visual">
        <div class="auth-visual-bg"></div>
        <a href="/" class="auth-logo"><span>TIME</span> EDGE</a>
        <div class="auth-visual-quote">
            <p>"Time is the most precious thing a man can spend."</p>
            <cite>— Theophrastus</cite>
        </div>
    </div>

    <!-- Form panel -->
    <div class="auth-form-panel">
        <div class="auth-eyebrow">Welcome Back</div>
        <h1 class="auth-title">Sign <em>in</em></h1>
        <p class="auth-subtitle">Access your collection, orders, and exclusive member benefits.</p>

        <% if (message) { %>
        <div class="auth-alert">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span><%= message %></span>
        </div>
        <% } %>

        <form action="/login" method="POST" id="loginForm">
            <div class="form-group">
                <label class="form-label" for="email">Email Address</label>
                <div class="input-wrap">
                    <input type="email" class="form-input" id="email" name="email" placeholder="you@example.com" required autocomplete="email">
                </div>
            </div>
            <div class="form-group">
                <label class="form-label" for="password">Password</label>
                <div class="input-wrap">
                    <input type="password" class="form-input" id="password" name="password" placeholder="••••••••" required autocomplete="current-password">
                    <i class="fa-regular fa-eye input-icon" id="togglePwd" onclick="togglePassword()"></i>
                </div>
                <a href="/forgot-password" class="forgot-link">Forgot password?</a>
            </div>

            <button type="submit" class="btn-submit">
                Sign In &nbsp; <i class="fa-solid fa-arrow-right"></i>
            </button>
        </form>

        <div class="or-divider"><span>or</span></div>

        <a href="/auth/google" class="btn-google">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
            Continue with Google
        </a>

        <div class="auth-footer">
            Don't have an account? &nbsp;<a href="/signup">Create one</a>
        </div>
    </div>
</div>

<script>
function togglePassword() {
    const pwd = document.getElementById('password');
    const icon = document.getElementById('togglePwd');
    if (pwd.type === 'password') {
        pwd.type = 'text';
        icon.className = 'fa-regular fa-eye-slash input-icon';
    } else {
        pwd.type = 'password';
        icon.className = 'fa-regular fa-eye input-icon';
    }
}
</script>
</body>
</html>
