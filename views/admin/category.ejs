<%- include("../../views/partials/admin/header") %>

<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@10/dist/sweetalert2.min.css"/>
    <style>
        .badge-success-te {
            padding: 4px 10px; font-size: 9px; letter-spacing: 0.5px; font-weight: 600; text-transform: uppercase; border-radius: 2px;
            background: rgba(109,191,127,0.08); color: #6dbf7f; border: 1px solid rgba(109,191,127,0.15);
        }
        .badge-danger-te {
            padding: 4px 10px; font-size: 9px; letter-spacing: 0.5px; font-weight: 600; text-transform: uppercase; border-radius: 2px;
            background: rgba(224,112,112,0.08); color: #e07070; border: 1px solid rgba(224,112,112,0.15);
        }
        .btn-table-action {
            background: none !important;
            border: 1px solid var(--border) !important;
            padding: 6px 12px !important;
            font-size: 11px !important;
            text-transform: uppercase !important;
            letter-spacing: 1px !important;
            font-weight: 600 !important;
            border-radius: 0 !important;
            transition: var(--transition);
            text-decoration: none;
            display: inline-block;
        }
        .btn-table-action.block { color: #e07070 !important; }
        .btn-table-action.block:hover { background: rgba(224,112,112,0.05) !important; border-color: #e07070 !important; }
        .btn-table-action.unblock { color: #6dbf7f !important; }
        .btn-table-action.unblock:hover { background: rgba(109,191,127,0.05) !important; border-color: #6dbf7f !important; }
        .btn-table-action.edit { color: var(--gold) !important; margin-left: 6px; }
        .btn-table-action.edit:hover { background: var(--gold-glow) !important; border-color: var(--gold) !important; }

        /* Search input bar overrides */
        .search-container {
            max-width: 500px;
            margin-bottom: 28px;
            display: flex;
            gap: 10px;
        }

        /* Pagination */
        .pagination-container { display: flex; justify-content: center; gap: 8px; margin-top: 32px; }
        .pagination-container a, .pagination-container .current-page {
            display: inline-flex; align-items: center; justify-content: center;
            width: 40px; height: 40px; border: 1px solid var(--border);
            text-decoration: none; font-size: 13px; color: var(--text-secondary); transition: var(--transition);
        }
        .pagination-container a:hover, .pagination-container .current-page {
            border-color: var(--gold); color: var(--gold); background: var(--gold-glow);
        }
    </style>
</head>

<div class="content-container">
    <div class="content-header mb-5 animate-up">
        <span style="font-size:10px; letter-spacing:2px; text-transform:uppercase; color:var(--text-muted);">Catalog Settings</span>
        <h2 style="font-family:'Playfair Display',serif; font-size:1.8rem; font-weight:500; margin-top:4px;">Categories</h2>
    </div>

    <!-- Search Form -->
    <div class="search-container animate-up delay-1">
        <form action="/admin/category" method="GET" class="w-100 d-flex gap-2">
            <input type="text" class="form-control" placeholder="Search categories..." name="search" value="<%= locals.searchQuery || '' %>" />
            <button class="btn-primary" type="submit">Search</button>
        </form>
    </div>

    <div class="row g-4 animate-up delay-2">
        <!-- Add Category Form panel -->
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h4>Add New Category</h4>
                </div>
                <div class="card-body">
                    <form method="POST" action="/admin/addCategory" id="categoryCreateForm" onsubmit="return validateCategoryForm()">
                        <div class="mb-4">
                            <label for="product_name" class="form-label">Category Name</label>
                            <input type="text" name="name" placeholder="e.g. Chronographs" class="form-control" id="product_name" required />
                            <div class="invalid-feedback" id="nameError"></div>
                        </div>
                        <div class="mb-4">
                            <label class="form-label" for="descriptionId">Description</label>
                            <textarea placeholder="e.g. High precision stopwatch functional watches" name="description" class="form-control" id="descriptionId" rows="4" required></textarea>
                            <div class="invalid-feedback" id="descriptionError"></div>
                        </div>
                        <button class="btn-primary w-100" type="submit">Create Category</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Categories Table list panel -->
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h4>All Categories</h4>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table mb-0" style="vertical-align: middle;">
                            <thead>
                                <tr>
                                    <th style="width: 60px;">#</th>
                                    <th>Category Name</th>
                                    <th>Description</th>
                                    <th>Status</th>
                                    <th style="width: 180px; text-align: right; padding-right: 24px !important;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                 <% if (locals.category && category.length > 0) { %>
                                     <% category.reverse().forEach((catItem, index) => { %>
                                         <tr>
                                             <td><%= index + 1 %></td>
                                             <td style="font-weight: 600; color: var(--text-primary);"><%= catItem.name %></td>
                                             <td><%= catItem.description %></td>
                                             <td>
                                                 <% if (catItem.isListed) { %>
                                                     <span class="badge-success-te">Listed</span>
                                                 <% } else { %>
                                                     <span class="badge-danger-te">Unlisted</span>
                                                 <% } %>
                                             </td>
                                             <td style="text-align: right; padding-right: 24px !important;">
                                                 <% if (catItem.isListed) { %>
                                                     <a href="/admin/unlistCategory?id=<%= catItem._id %>" class="btn-table-action block">Unlist</a>
                                                 <% } else { %>
                                                     <a href="/admin/listCategory?id=<%= catItem._id %>" class="btn-table-action unblock">List</a>
                                                 <% } %>
                                                 <a href="/admin/editCategory?id=<%= catItem._id %>" class="btn-table-action edit">Edit</a>
                                             </td>
                                         </tr>
                                     <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5" class="text-center py-5 text-muted">No Categories Found</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Pagination block -->
            <% if (locals.totalPages && totalPages > 1) { %>
            <div class="pagination-container">
                <% if (currentPage > 1) { %>
                    <a href="?page=<%= currentPage - 1 %><%= locals.searchQuery ? '&search=' + locals.searchQuery : '' %>"><i class="fa-solid fa-chevron-left"></i></a>
                <% } %>
                <% for (let i = 1; i <= totalPages; i++) { %>
                    <% if (i === currentPage) { %>
                        <span class="current-page"><%= i %></span>
                    <% } else { %>
                        <a href="?page=<%= i %><%= locals.searchQuery ? '&search=' + locals.searchQuery : '' %>"><%= i %></a>
                    <% } %>
                <% } %>
                <% if (currentPage < totalPages) { %>
                    <a href="?page=<%= currentPage + 1 %><%= locals.searchQuery ? '&search=' + locals.searchQuery : '' %>"><i class="fa-solid fa-chevron-right"></i></a>
                <% } %>
            </div>
            <% } %>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@10/dist/sweetalert2.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script>
document.getElementById('categoryCreateForm').addEventListener('submit', function(event) {
    event.preventDefault();
    if (!validateCategoryForm()) {
        return;
    }
    const name = document.getElementById("product_name").value.trim();
    const description = document.getElementById("descriptionId").value.trim();

    $.ajax({
        url: "/admin/addCategory",
        method: "POST",
        data: { name, description },
        success: (response) => {
            if (response.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Category Created',
                    text: response.message || 'Category added successfully',
                    confirmButtonColor: '#b39343'
                }).then(() => {
                    window.location.reload();
                });
            } else {
                Swal.fire('Failed', response.message || 'Unable to add category', 'error');
            }
        },
        error: (err) => {
            const errorMsg = err.responseJSON ? err.responseJSON.message : 'An error occurred while adding the category';
            Swal.fire('Error', errorMsg, 'error');
        }
    });
});

function validateCategoryForm() {
    var name = document.getElementById("product_name").value.trim();
    var desc = document.getElementById("descriptionId").value.trim();
    var isValid = true;
    if (name === "") {
        document.getElementById("nameError").innerText = "Category Name is required";
        document.getElementById("product_name").classList.add("is-invalid");
        isValid = false;
    } else {
        document.getElementById("nameError").innerText = "";
        document.getElementById("product_name").classList.remove("is-invalid");
    }
    if (desc === "") {
        document.getElementById("descriptionError").innerText = "Description is required";
        document.getElementById("descriptionId").classList.add("is-invalid");
        isValid = false;
    } else {
        document.getElementById("descriptionError").innerText = "";
        document.getElementById("descriptionId").classList.remove("is-invalid");
    }
    return isValid;
}
</script>

<%- include("../../views/partials/admin/footer") %>