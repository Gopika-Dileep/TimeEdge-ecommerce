<%- include("../../views/partials/admin/header") %>

<div class="content-container">
    <div class="content-header mb-5 animate-up">
        <span style="font-size:10px; letter-spacing:2px; text-transform:uppercase; color:var(--text-muted);">Marketing Tools</span>
        <h2 style="font-family:'Playfair Display',serif; font-size:1.8rem; font-weight:500; margin-top:4px;">Edit Coupon</h2>
    </div>

    <div class="row g-4 animate-up delay-1 justify-content-center">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h4>Edit Coupon Details</h4>
                </div>
                <div class="card-body">
                    <form id="editCouponForm">
                        <div class="mb-4">
                            <label for="coupon_name" class="form-label">Coupon Code</label>
                            <input type="text" name="name" id="coupon_name" value="<%= coupon.name %>" placeholder="e.g. TIMEDGE15" class="form-control" required style="text-transform: uppercase;" />
                        </div>
                        <div class="mb-4">
                            <label for="offerPrice" class="form-label">Discount Amount (₹)</label>
                            <input type="number" name="offerPrice" id="offerPrice" value="<%= coupon.offerPrice %>" placeholder="e.g. 500" class="form-control" min="1" required />
                        </div>
                        <div class="mb-4">
                            <label for="minimumPrice" class="form-label">Minimum Purchase (₹)</label>
                            <input type="number" name="minimumPrice" id="minimumPrice" value="<%= coupon.minimumPrice %>" placeholder="e.g. 2999" class="form-control" min="0" required />
                        </div>
                        <div class="mb-4">
                            <label for="UsageLimit" class="form-label">Usage Limit (Max Uses)</label>
                            <input type="number" name="UsageLimit" id="UsageLimit" value="<%= coupon.UsageLimit %>" placeholder="e.g. 100" class="form-control" min="1" required />
                        </div>
                        <div class="mb-4">
                            <label for="expireOn" class="form-label">Expiry Date</label>
                            <input type="date" name="expireOn" id="expireOn" value="<%= new Date(coupon.expireOn).toISOString().split('T')[0] %>" class="form-control" required />
                        </div>
                        <div class="d-flex gap-3">
                            <button class="btn-primary flex-grow-1" type="submit">Update Coupon</button>
                            <a href="/admin/coupon" class="btn btn-secondary flex-grow-1" style="display: flex; align-items: center; justify-content: center; height: 45px; border-radius: 4px; border: 1px solid var(--border); background: transparent; color: var(--text-secondary); text-decoration: none; font-size: 13px; font-weight: 500; transition: var(--transition);">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script>
$(document).ready(function() {
    $('#editCouponForm').submit(function(event) {
        event.preventDefault();
        
        const name = $('#coupon_name').val().trim().toUpperCase();
        const offerPrice = parseFloat($('#offerPrice').val());
        const minimumPrice = parseFloat($('#minimumPrice').val());
        const UsageLimit = parseInt($('#UsageLimit').val());
        const expireOn = $('#expireOn').val();
        
        if (!name) {
            Swal.fire('Error', 'Coupon Code is required', 'error');
            return;
        }
        if (!/^[A-Z0-9]+$/.test(name)) {
            Swal.fire('Error', 'Coupon Code must contain alphanumeric characters only (letters and numbers)', 'error');
            return;
        }
        if (isNaN(offerPrice) || offerPrice <= 0) {
            Swal.fire('Error', 'Discount Amount must be greater than 0', 'error');
            return;
        }
        if (isNaN(minimumPrice) || minimumPrice < 0) {
            Swal.fire('Error', 'Minimum Purchase must be at least 0', 'error');
            return;
        }
        if (offerPrice >= minimumPrice) {
            Swal.fire('Error', 'Discount amount must be less than minimum purchase amount', 'error');
            return;
        }
        if (isNaN(UsageLimit) || UsageLimit <= 0) {
            Swal.fire('Error', 'Usage Limit must be at least 1', 'error');
            return;
        }
        if (!expireOn) {
            Swal.fire('Error', 'Expiry Date is required', 'error');
            return;
        }
        
        const today = new Date();
        today.setHours(0,0,0,0);
        if (new Date(expireOn) < today) {
            Swal.fire('Error', 'Expiry Date cannot be in the past', 'error');
            return;
        }
        
        $.ajax({
            url: '/admin/editCoupon?id=<%= coupon._id %>',
            method: 'POST',
            data: {
                code: name,
                offerPrice: offerPrice,
                minimumPrice: minimumPrice,
                UsageLimit: UsageLimit,
                expireOn: expireOn
            },
            success: function(response) {
                Swal.fire({
                    icon: 'success',
                    title: 'Coupon Updated',
                    text: 'Coupon has been successfully updated.',
                    confirmButtonColor: '#b39343'
                }).then(() => {
                    window.location.href = '/admin/coupon';
                });
            },
            error: function(xhr) {
                const errorMsg = xhr.responseJSON ? (xhr.responseJSON.error || xhr.responseJSON.message) : 'Failed to update coupon';
                Swal.fire('Error', errorMsg, 'error');
            }
        });
    });
});
</script>

<%- include("../../views/partials/admin/footer") %>