<%- include("../../views/partials/admin/header") %>

<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cropperjs/dist/cropper.min.css">
    <style>
        .error-message {
            color: #e07070;
            margin-top: 6px;
            font-size: 12px;
            display: none;
        }
        .form-section-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.1rem;
            color: var(--text-primary);
            margin-bottom: 20px;
            padding-bottom: 8px;
            border-bottom: 1px solid var(--border);
            font-weight: 500;
        }
        .image-upload-card {
            border: 1px dashed var(--border);
            padding: 24px 16px;
            text-align: center;
            background: rgba(0,0,0,0.01);
            position: relative;
            cursor: pointer;
            transition: var(--transition);
            margin-bottom: 16px;
            min-height: 140px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
        .image-upload-card:hover {
            border-color: var(--gold);
            background: var(--gold-glow);
        }
        .preview-img-box {
            max-width: 100%;
            max-height: 140px;
            object-fit: contain;
            display: block;
            margin: 10px auto 0;
            border: 1px solid var(--border);
            background: #ffffff;
        }
        .action-overlay-bar {
            display: none;
            position: absolute;
            bottom: 8px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 15;
            gap: 8px;
            background: rgba(0, 0, 0, 0.75);
            padding: 4px 10px;
            border-radius: 20px;
        }
        .action-overlay-btn {
            background: none;
            border: none;
            cursor: pointer;
            padding: 4px;
            font-size: 11px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: 0.2s;
        }
        .action-overlay-btn.crop { color: #fff; }
        .action-overlay-btn.crop:hover { color: var(--gold); transform: scale(1.1); }
        .action-overlay-btn.delete { color: #e07070; }
        .action-overlay-btn.delete:hover { color: #ff8888; transform: scale(1.1); }
    </style>
</head>

<div class="content-container">
    <div class="content-header mb-5 animate-up">
        <span style="font-size:10px; letter-spacing:2px; text-transform:uppercase; color:var(--text-muted);">Catalog Management</span>
        <h2 style="font-family:'Playfair Display',serif; font-size:1.8rem; font-weight:500; margin-top:4px;">Add New Product</h2>
    </div>

    <div class="card animate-up delay-1" style="max-width: 1000px;">
        <div class="card-body">
            <form method="post" action="/admin/addProducts" enctype="multipart/form-data" onsubmit="return validateForm()">
                <div class="row g-5">
                    
                    <!-- Left Column: Details -->
                    <div class="col-lg-7">
                        <div class="form-section-title">Product Details</div>

                        <div class="mb-4">
                            <label for="product_name" class="form-label">Product Name</label>
                            <input type="text" placeholder="e.g. Royal Oak Chronograph" name="productName" class="form-control" id="product_name" required>
                            <div id="productName-error" class="error-message"></div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label class="form-label" for="brandSelect">Brand</label>
                                <select class="form-select" name="brand" id="brandSelect" required>
                                    <option value="" disabled selected>Select Brand</option>
                                    <% for(let i = 0; i < brand.length; i++) { %>
                                        <option value="<%= brand[i].name %>"><%= brand[i].name %></option>
                                    <% } %>
                                </select>
                                <div id="brand-error" class="error-message"></div>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label class="form-label" for="categorySelect">Category</label>
                                <select class="form-select" name="category" id="categorySelect" required>
                                    <option value="" disabled selected>Select Category</option>
                                    <% for(let i = 0; i < cat.length; i++) { %>
                                        <option value="<%= cat[i].name %>"><%= cat[i].name %></option>
                                    <% } %>
                                </select>
                                <div id="category-error" class="error-message"></div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label" for="descriptionid">Full Description</label>
                            <textarea placeholder="e.g. Elegant watch with fine gold bezel and authentic alligator strap." id="descriptionid" name="description" class="form-control" rows="5" required></textarea>
                            <div id="description-error" class="error-message"></div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-4">
                                <label class="form-label" for="regPrice">Regular Price (₹)</label>
                                <input placeholder="e.g. 15000" name="regularPrice" id="regPrice" type="number" class="form-control" min="1000" max="100000" required>
                                <div id="regularPrice-error" class="error-message"></div>
                            </div>
                            <div class="col-md-4 mb-4">
                                <label class="form-label" for="salePrice">Sale Price (₹)</label>
                                <input placeholder="e.g. 12000" name="salePrice" id="salePrice" type="number" class="form-control" min="1000" max="100000" required>
                                <div id="salePrice-error" class="error-message"></div>
                            </div>
                            <div class="col-md-4 mb-4">
                                <label class="form-label" for="quantityInput">Stock Quantity</label>
                                <input placeholder="e.g. 10" name="quantity" id="quantityInput" type="number" class="form-control" min="0" required>
                                <div id="quantity-error" class="error-message"></div>
                            </div>
                        </div>

                        <div class="mb-4" style="max-width: 280px;">
                            <label class="form-label" for="colorInput">Watch Color / Dial Finish</label>
                            <input name="color" id="colorInput" type="text" placeholder="e.g. Rose Gold / Black" class="form-control" required>
                            <div id="color-error" class="error-message"></div>
                        </div>
                    </div>

                    <!-- Right Column: Images & Upload -->
                    <div class="col-lg-5">
                        <div class="form-section-title">Product Imagery</div>
                        <p style="font-size:11px; color:var(--text-muted); margin-bottom: 20px;">Upload up to 4 high-quality product images. Front-facing clean images recommended.</p>

                        <div class="row g-3">
                            <% for (let slot = 1; slot <= 4; slot++) { %>
                                <div class="col-6">
                                    <div class="image-upload-card" id="card<%= slot %>" onclick="document.getElementById('input<%= slot %>').click();" style="position: relative; overflow: hidden; min-height: 140px; display: flex; align-items: center; justify-content: center; margin-bottom:0;">
                                        <!-- Placeholder -->
                                        <div class="upload-placeholder" id="placeholder<%= slot %>" style="text-align: center; pointer-events: none;">
                                            <i class="fa-solid fa-camera" style="font-size: 16px; color: var(--text-muted); margin-bottom: 6px;"></i>
                                            <div style="font-size: 10px; font-weight:600; color:var(--text-secondary);">IMAGE <%= slot %></div>
                                        </div>
                                        
                                        <!-- Preview Box inside boundaries -->
                                        <img src="" alt="" id="imgView<%= slot %>" class="preview-img-box" style="display:none; position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: contain; background: #fff; margin:0; padding: 4px; border:none;">
                                        
                                        <!-- Hover Action Overlay Bar -->
                                        <div class="action-overlay-bar" id="actionOverlay<%= slot %>">
                                            <button type="button" class="action-overlay-btn crop" onclick="openCropper(event, '<%= slot %>')" title="Crop Image">
                                                <i class="fa-solid fa-crop-simple"></i>
                                            </button>
                                            <button type="button" class="action-overlay-btn delete" onclick="clearImage(event, '<%= slot %>')" title="Remove Image">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <input class="form-control" type="file" name="images" id="input<%= slot %>" accept="image/*" style="display:none;" onchange="viewImage(event, '<%= slot %>')">
                                    <% if (slot === 1) { %>
                                        <div id="images-error" class="error-message" style="margin-top:4px;"></div>
                                    <% } %>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <div class="mt-5 pt-4 border-top">
                    <button class="btn-primary" type="submit">Publish Product</button>
                    <a href="/admin/product" class="btn-table-action" style="margin-left: 12px; padding: 12px 24px !important; display: inline-block; text-decoration: none;">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Global Center-Screen Cropper Modal -->
<div id="cropperModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.75); z-index: 9999; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
    <div style="background: #fff; width: 90%; max-width: 480px; padding: 24px; border: 1px solid var(--border); position: relative; box-shadow: 0 10px 40px rgba(0,0,0,0.3);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid var(--border); padding-bottom: 12px;">
            <h5 style="font-family: 'Playfair Display', serif; font-size: 1.1rem; font-weight: 500; margin: 0; color: var(--text-primary);">Crop Product Image</h5>
            <button type="button" onclick="closeCropperModal()" style="background: none; border: none; font-size: 20px; cursor: pointer; color: var(--text-muted); line-height: 1;">&times;</button>
        </div>
        <div id="cropperTargetContainer" style="max-height: 360px; overflow: hidden; display: flex; align-items: center; justify-content: center; background: #f8f9fa; border: 1px solid var(--border); margin-bottom: 20px; height: 300px;">
            <img id="cropperTargetImage" src="" alt="To Crop" style="max-width: 100%; max-height: 360px; display: block;">
        </div>
        <div style="display: flex; justify-content: flex-end; gap: 12px;">
            <button type="button" class="btn-table-action" onclick="closeCropperModal()" style="padding: 10px 20px !important;">Cancel</button>
            <button type="button" class="btn-primary" id="cropperSaveBtn" style="padding: 10px 20px !important; line-height: 1.2;">Crop & Save</button>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/cropperjs/dist/cropper.min.js"></script>
<script>
let currentCropperIndex = null;
let cropperInstance = null;

function viewImage(event, index) {
    const input = event.target;
    if (input.files && input.files[0]) {
        const file = input.files[0];
        
        // Render image inside card boundary box immediately
        const previewImg = document.getElementById("imgView" + index);
        previewImg.src = URL.createObjectURL(file);
        previewImg.style.display = 'block';
        
        // Update visibility controls
        document.getElementById("placeholder" + index).style.display = 'none';
        document.getElementById("actionOverlay" + index).style.display = 'flex';
    }
}

function openCropper(event, index) {
    if (event) event.stopPropagation(); // prevent file input prompt trigger
    
    const fileInput = document.getElementById("input" + index);
    if (fileInput.files && fileInput.files[0]) {
        const reader = new FileReader();
        reader.onload = function () {
            const dataURL = reader.result;
            
            if (cropperInstance) {
                cropperInstance.destroy();
                cropperInstance = null;
            }
            
            // Re-create the image element dynamically to clear sizing/caching artifacts
            const container = document.getElementById("cropperTargetContainer");
            container.innerHTML = `<img id="cropperTargetImage" src="${dataURL}" alt="To Crop" style="max-width: 100%; max-height: 300px; display: block;">`;
            
            const targetImage = document.getElementById("cropperTargetImage");
            currentCropperIndex = index;
            
            // Open modal
            const modal = document.getElementById("cropperModal");
            modal.style.display = "flex";
            
            // Wait for image loading before initializing Cropper
            targetImage.onload = function() {
                cropperInstance = new Cropper(targetImage, {
                    aspectRatio: 1 / 1,
                    viewMode: 1,
                    dragMode: 'move',
                    guides: true,
                    background: true,
                    autoCropArea: 0.8,
                    zoomable: true,
                    scalable: true,
                    movable: true
                });
            };
        };
        reader.readAsDataURL(fileInput.files[0]);
    }
}

// Bind crop save button handler
document.getElementById("cropperSaveBtn").addEventListener("click", function () {
    if (!cropperInstance || currentCropperIndex === null) return;
    
    const croppedCanvas = cropperInstance.getCroppedCanvas();
    if (!croppedCanvas) {
        alert("Error: Could not crop the image. Try again.");
        return;
    }
    
    const index = currentCropperIndex;
    const finalDataURL = croppedCanvas.toDataURL("image/jpeg", 1.0);
    
    // Set preview image in the upload card
    const previewImg = document.getElementById("imgView" + index);
    previewImg.src = finalDataURL;
    previewImg.style.display = 'block';
    
    const timestamp = new Date().getTime();
    const fileName = `cropped-img-${timestamp}-${index}.png`;
    
    croppedCanvas.toBlob((blob) => {
        const fileInput = document.getElementById("input" + index);
        const file = new File([blob], fileName, { type: "image/png" });
        
        const dataTransfer = new DataTransfer();
        dataTransfer.items.add(file);
        fileInput.files = dataTransfer.files;
        
        closeCropperModal();
    }, "image/png");
});

function closeCropperModal() {
    document.getElementById("cropperModal").style.display = "none";
    if (cropperInstance) {
        cropperInstance.destroy();
        cropperInstance = null;
    }
    currentCropperIndex = null;
}

function clearImage(event, index) {
    if (event) event.stopPropagation(); // prevent file input prompt
    
    const fileInput = document.getElementById("input" + index);
    fileInput.value = "";
    
    const image = document.getElementById("imgView" + index);
    image.src = "";
    image.style.display = 'none';
    
    document.getElementById("actionOverlay" + index).style.display = 'none';
    document.getElementById("placeholder" + index).style.display = 'block';
}

function validateForm() {
    clearErrorMessages();
    const name = document.getElementsByName('productName')[0].value;
    const description = document.getElementById('descriptionid').value;
    const brand = document.getElementsByName('brand')[0].value;
    const price = document.getElementsByName('regularPrice')[0].value;
    const saleprice = document.getElementsByName('salePrice')[0].value;
    const color = document.getElementsByName('color')[0].value;
    const images = document.getElementById('input1');
    const quantity = document.getElementsByName('quantity')[0].value;
    let isValid = true;

    if (name.trim() === "") {
        displayErrorMessage('productName-error', 'Please enter a product name.');
        isValid = false;
    } else if (!/^[a-zA-Z0-9\s;,.]+$/.test(name.trim())) {
        displayErrorMessage('productName-error', 'Product name can only contain letters, numbers, spaces, and: ; , .');
        isValid = false;
    }

    if (description.trim() === "") {
        displayErrorMessage('description-error', 'Please enter a product description.');
        isValid = false;
    }

    if (!quantity || parseInt(quantity) < 0) {
        displayErrorMessage('quantity-error', 'Please enter a valid non-negative quantity.');
        isValid = false;
    }

    const sanitizedPrice = price.trim().replace(/,/g, '');
    if (!/^\d+(\.\d{1,2})?$/.test(sanitizedPrice) || parseFloat(sanitizedPrice) < 0) {
        displayErrorMessage('regularPrice-error', 'Enter a valid regular price.');
        isValid = false;
    }

    const sanitizedSalePrice = saleprice.trim().replace(/,/g, '');
    if (!/^\d+(\.\d{1,2})?$/.test(sanitizedSalePrice) || parseFloat(sanitizedSalePrice) < 0) {
        displayErrorMessage('salePrice-error', 'Enter a valid sale price.');
        isValid = false;
    }

    if (parseFloat(price) < parseFloat(saleprice)) {
        displayErrorMessage('regularPrice-error', 'Regular price must be greater than or equal to sale price.');
        isValid = false;
    }

    if (brand.trim() === "") {
        displayErrorMessage('brand-error', 'Please select a brand.');
        isValid = false;
    }

    const categorySelect = document.getElementById('categorySelect');
    if (!categorySelect.value) {
        displayErrorMessage('category-error', 'Please select a category.');
        isValid = false;
    }

    if (color.trim() === "") {
        displayErrorMessage('color-error', 'Please enter a color.');
        isValid = false;
    }

    if (images.files.length === 0) {
        displayErrorMessage("images-error", 'Please upload at least the primary product image (Image 1).');
        isValid = false;
    }
    return isValid;
}

function displayErrorMessage(elementId, message) {
    var errorElement = document.getElementById(elementId);
    errorElement.innerText = message;
    errorElement.style.display = "block";
}

function clearErrorMessages() {
    const errorElements = document.getElementsByClassName('error-message');
    Array.from(errorElements).forEach(element => {
        element.innerText = '';
        element.style.display = 'none';
    });
}
</script>

<%- include("../../views/partials/admin/footer") %>