<%- include("../../views/partials/admin/header") %>

<head>
    <style>
        .coupon-code {
            font-family: 'Playfair Display', serif;
            font-weight: 600;
            color: var(--gold);
            letter-spacing: 1px;
        }
        .action-del {
            color: #e07070 !important;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .action-del:hover {
            color: #c95252 !important;
        }
    </style>
</head>

<div class="content-container">
    <div class="content-header mb-5 animate-up">
        <span style="font-size:10px; letter-spacing:2px; text-transform:uppercase; color:var(--text-muted);">Marketing Tools</span>
        <h2 style="font-family:'Playfair Display',serif; font-size:1.8rem; font-weight:500; margin-top:4px;">Coupons Management</h2>
    </div>

    <div class="row g-4 animate-up delay-1">
        <!-- Add Coupon side panel -->
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h4>Create Coupon</h4>
                </div>
                <div class="card-body">
                    <form method="POST" action="/admin/addCoupon" id="createCouponForm">
                        <div class="mb-4">
                            <label for="coupon_name" class="form-label">Coupon Code</label>
                            <input type="text" name="name" id="coupon_name" placeholder="e.g. TIMEDGE15" class="form-control" required style="text-transform: uppercase;" />
                        </div>
                        <div class="mb-4">
                            <label for="offerPrice" class="form-label">Discount Amount (₹)</label>
                            <input type="number" name="offerPrice" id="offerPrice" placeholder="e.g. 500" class="form-control" min="1" required />
                        </div>
                        <div class="mb-4">
                            <label for="minimumPrice" class="form-label">Minimum Purchase (₹)</label>
                            <input type="number" name="minimumPrice" id="minimumPrice" placeholder="e.g. 2999" class="form-control" min="0" required />
                        </div>
                        <div class="mb-4">
                            <label for="expireOn" class="form-label">Expiry Date</label>
                            <input type="date" name="expireOn" id="expireOn" class="form-control" required />
                        </div>
                        <button class="btn-primary w-100" type="submit">Create Coupon</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Coupons Table List panel -->
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h4>Active Coupons</h4>
                    <form action="/admin/coupon" method="GET" style="max-width: 250px; display: flex; gap: 8px; margin: 0;">
                        <input type="text" class="form-control form-control-sm" placeholder="Search coupons..." name="search" value="<%= locals.search || '' %>" style="height: 32px; font-size: 12px;" />
                        <button class="btn btn-primary btn-sm" type="submit" style="padding: 4px 12px !important; font-size: 11px; height: 32px;">Search</button>
                    </form>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table mb-0" style="vertical-align: middle;">
                            <thead>
                                <tr>
                                    <th>Coupon Code</th>
                                    <th>Discount</th>
                                    <th>Min. Spend</th>
                                    <th>Expires On</th>
                                    <th style="width: 120px; text-align: right; padding-right: 24px !important;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (locals.coupons && coupons.length > 0) { %>
                                    <% coupons.forEach(coupon => { %>
                                        <tr>
                                            <td class="coupon-code"><%= coupon.name %></td>
                                            <td style="font-weight: 600; color: var(--text-primary);">₹<%= coupon.offerPrice.toLocaleString('en-IN') %></td>
                                            <td>₹<%= coupon.minimumPrice.toLocaleString('en-IN') %></td>
                                            <td><%= new Date(coupon.expireOn).toLocaleDateString('en-IN', {year:'numeric',month:'short',day:'numeric'}) %></td>
                                            <td style="text-align: right; padding-right: 24px !important;">
                                                <a href="/admin/deleteCoupon?id=<%= coupon._id %>" class="action-del">
                                                    <i class="fa-solid fa-trash-can"></i> Delete
                                                </a>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5" class="text-center py-5 text-muted">No Coupons Found</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            
            <!-- Pagination block -->
            <% if (locals.totalpage && totalpage > 1) { %>
            <div class="pagination-container animate-up" style="display: flex; justify-content: center; gap: 8px; margin-top: 32px;">
                <% if (currentpage > 1) { %>
                    <a href="?page=<%= currentpage - 1 %><%= locals.search ? '&search=' + locals.search : '' %>" style="display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border: 1px solid var(--border); text-decoration: none; font-size: 13px; color: var(--text-secondary); transition: var(--transition);"><i class="fa-solid fa-chevron-left"></i></a>
                <% } %>
                <% for (let i = 1; i <= totalpage; i++) { %>
                    <% if (i === currentpage) { %>
                        <span class="current-page" style="display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border: 1px solid var(--gold); color: var(--gold); background: var(--gold-glow); font-size: 13px;"><%= i %></span>
                    <% } else { %>
                        <a href="?page=<%= i %><%= locals.search ? '&search=' + locals.search : '' %>" style="display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border: 1px solid var(--border); text-decoration: none; font-size: 13px; color: var(--text-secondary); transition: var(--transition);"><%= i %></a>
                    <% } %>
                <% } %>
                <% if (currentpage < totalpage) { %>
                    <a href="?page=<%= currentpage + 1 %><%= locals.search ? '&search=' + locals.search : '' %>" style="display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border: 1px solid var(--border); text-decoration: none; font-size: 13px; color: var(--text-secondary); transition: var(--transition);"><i class="fa-solid fa-chevron-right"></i></a>
                <% } %>
            </div>
            <% } %>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script>
$(document).ready(function() {
    $('#createCouponForm').submit(function(event) {
        event.preventDefault();
        
        const name = $('#coupon_name').val().trim().toUpperCase();
        const offerPrice = parseFloat($('#offerPrice').val());
        const minimumPrice = parseFloat($('#minimumPrice').val());
        const expireOn = $('#expireOn').val();
        
        if (!name) {
            Swal.fire('Error', 'Coupon Code is required', 'error');
            return;
        }
        if (isNaN(offerPrice) || offerPrice <= 0) {
            Swal.fire('Error', 'Discount Amount must be greater than 0', 'error');
            return;
        }
        if (isNaN(minimumPrice) || minimumPrice < 0) {
            Swal.fire('Error', 'Minimum Purchase must be at least 0', 'error');
            return;
        }
        if (offerPrice >= minimumPrice) {
            Swal.fire('Error', 'Discount amount must be less than minimum purchase amount', 'error');
            return;
        }
        if (!expireOn) {
            Swal.fire('Error', 'Expiry Date is required', 'error');
            return;
        }
        
        $.ajax({
            url: '/admin/addCoupon',
            method: 'POST',
            data: {
                name: name,
                offerPrice: offerPrice,
                minimumPrice: minimumPrice,
                expireOn: expireOn
            },
            success: function(response) {
                Swal.fire({
                    icon: 'success',
                    title: 'Coupon Created',
                    text: 'Coupon has been successfully created.',
                    confirmButtonColor: '#b39343'
                }).then(() => {
                    window.location.reload();
                });
            },
            error: function(xhr) {
                const errorMsg = xhr.responseJSON ? (xhr.responseJSON.error || xhr.responseJSON.message) : 'Failed to create coupon';
                Swal.fire('Error', errorMsg, 'error');
            }
        });
    });

    $(document).on('click', '.action-del', function(e) {
        e.preventDefault();
        const href = $(this).attr('href');
        Swal.fire({
            title: 'Delete Coupon?',
            text: "You won't be able to revert this!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#b39343',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = href;
            }
        });
    });
});
</script>

<%- include("../../views/partials/admin/footer") %>
