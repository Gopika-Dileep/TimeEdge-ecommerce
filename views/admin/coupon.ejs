<%- include("../../views/partials/admin/header") %>

<head>
    <style>
        .coupon-code {
            font-family: 'Playfair Display', serif;
            font-weight: 600;
            color: var(--gold);
            letter-spacing: 1px;
        }
        .action-del {
            color: #e07070 !important;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .action-del:hover {
            color: #c95252 !important;
        }
    </style>
</head>

<div class="content-container">
    <div class="content-header mb-5 animate-up">
        <span style="font-size:10px; letter-spacing:2px; text-transform:uppercase; color:var(--text-muted);">Marketing Tools</span>
        <h2 style="font-family:'Playfair Display',serif; font-size:1.8rem; font-weight:500; margin-top:4px;">Coupons Management</h2>
    </div>

    <div class="row g-4 animate-up delay-1">
        <!-- Add Coupon side panel -->
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h4>Create Coupon</h4>
                </div>
                <div class="card-body">
                    <form method="POST" action="/admin/addCoupon">
                        <div class="mb-4">
                            <label for="coupon_name" class="form-label">Coupon Code</label>
                            <input type="text" name="name" id="coupon_name" placeholder="e.g. TIMEDGE15" class="form-control" required style="text-transform: uppercase;" />
                        </div>
                        <div class="mb-4">
                            <label for="offerPrice" class="form-label">Discount Amount (₹)</label>
                            <input type="number" name="offerPrice" id="offerPrice" placeholder="e.g. 500" class="form-control" min="1" required />
                        </div>
                        <div class="mb-4">
                            <label for="minimumPrice" class="form-label">Minimum Purchase (₹)</label>
                            <input type="number" name="minimumPrice" id="minimumPrice" placeholder="e.g. 2999" class="form-control" min="0" required />
                        </div>
                        <div class="mb-4">
                            <label for="expireOn" class="form-label">Expiry Date</label>
                            <input type="date" name="expireOn" id="expireOn" class="form-control" required />
                        </div>
                        <button class="btn-primary w-100" type="submit">Create Coupon</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Coupons Table List panel -->
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h4>Active Coupons</h4>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table mb-0" style="vertical-align: middle;">
                            <thead>
                                <tr>
                                    <th>Coupon Code</th>
                                    <th>Discount</th>
                                    <th>Min. Spend</th>
                                    <th>Expires On</th>
                                    <th style="width: 120px; text-align: right; padding-right: 24px !important;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (locals.coupons && coupons.length > 0) { %>
                                    <% coupons.forEach(coupon => { %>
                                        <tr>
                                            <td class="coupon-code"><%= coupon.name %></td>
                                            <td style="font-weight: 600; color: var(--text-primary);">₹<%= coupon.offerPrice.toLocaleString('en-IN') %></td>
                                            <td>₹<%= coupon.minimumPrice.toLocaleString('en-IN') %></td>
                                            <td><%= new Date(coupon.expireOn).toLocaleDateString('en-IN', {year:'numeric',month:'short',day:'numeric'}) %></td>
                                            <td style="text-align: right; padding-right: 24px !important;">
                                                <a href="/admin/deleteCoupon?id=<%= coupon._id %>" class="action-del" onclick="return confirm('Delete this coupon?')">
                                                    <i class="fa-solid fa-trash-can"></i> Delete
                                                </a>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5" class="text-center py-5 text-muted">No Coupons Found</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include("../../views/partials/admin/footer") %>
