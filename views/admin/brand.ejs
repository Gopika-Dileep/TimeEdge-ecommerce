<%- include("../../views/partials/admin/header") %>

<div class="content-container">
    <div class="content-header mb-5 animate-up">
        <span style="font-size:10px; letter-spacing:2px; text-transform:uppercase; color:var(--text-muted);">Catalog Settings</span>
        <h2 style="font-family:'Playfair Display',serif; font-size:1.8rem; font-weight:500; margin-top:4px;">Brands Management</h2>
    </div>

    <!-- Search Form -->
    <div class="search-container mb-4 animate-up delay-1">
        <form action="/admin/brand" method="GET" class="w-100 d-flex gap-2">
            <input type="text" class="form-control" placeholder="Search brands by name..." name="search" value="<%= locals.search || '' %>" />
            <button class="btn-primary" type="submit">Search</button>
            <% if (locals.search) { %>
                <a href="/admin/brand" class="btn btn-secondary" style="padding: 12px 20px; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; line-height: 1;">Clear</a>
            <% } %>
        </form>
    </div>

    <div class="row g-4 animate-up delay-1">
        <!-- Add Brand Side Panel -->
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h4>Add New Brand</h4>
                </div>
                <div class="card-body">
                    <form id="addBrandForm" method="POST" action="/admin/addBrand">
                        <div class="mb-4">
                            <label for="brand_name" class="form-label">Brand Name</label>
                            <input type="text" name="name" id="brand_name" placeholder="e.g. Audemars Piguet" class="form-control" />
                            <span id="brand_name_error" style="color:#e07070; font-size:12px; margin-top:5px; display:none;"></span>
                        </div>
                        <button class="btn-primary w-100" type="submit">Create Brand</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Brands Grid Table -->
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h4>All Brands</h4>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table mb-0" style="vertical-align: middle;">
                            <thead>
                                <tr>
                                    <th>Brand Name</th>
                                    <th>Status</th>
                                    <th style="width: 220px; text-align: right; padding-right: 24px !important;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (locals.brand && brand.length > 0) { %>
                                    <% brand.forEach((brandItem) => { %>
                                        <tr>
                                            <td style="font-weight: 600; color: var(--text-primary);"><%= brandItem.name %></td>
                                            <td>
                                                <% if (!brandItem.isListed) { %>
                                                    <span class="badge-danger-te">Blocked</span>
                                                <% } else { %>
                                                    <span class="badge-success-te">Active</span>
                                                <% } %>
                                            </td>
                                            <td style="text-align: right; padding-right: 24px !important;">
                                                <button class="btn-table-action" style="color: var(--gold); margin-right: 6px;" onclick="editBrand('<%= brandItem._id %>', '<%= brandItem.name %>')">Edit</button>
                                                <% if (brandItem.isListed) { %>
                                                    <form method="POST" action="/admin/blockBrand/<%= brandItem._id %>" style="display: inline;">
                                                        <button class="btn-table-action block" type="submit">Block</button>
                                                    </form>
                                                <% } else { %>
                                                    <form method="POST" action="/admin/unblockBrand/<%= brandItem._id %>" style="display: inline;">
                                                        <button class="btn-table-action unblock" type="submit">Unblock</button>
                                                    </form>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="4" class="text-center py-5 text-muted">No Brands Found</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Pagination block -->
            <% if (locals.totalpage && totalpage > 1) { %>
            <div class="pagination-container animate-up">
                <% if (currentpage > 1) { %>
                    <a href="?page=<%= currentpage - 1 %><%= locals.search ? '&search=' + locals.search : '' %>"><i class="fa-solid fa-chevron-left"></i></a>
                <% } %>
                <% for (let i = 1; i <= totalpage; i++) { %>
                    <% if (i === currentpage) { %>
                        <span class="current-page"><%= i %></span>
                    <% } else { %>
                        <a href="?page=<%= i %><%= locals.search ? '&search=' + locals.search : '' %>"><%= i %></a>
                    <% } %>
                <% } %>
                <% if (currentpage < totalpage) { %>
                    <a href="?page=<%= currentpage + 1 %><%= locals.search ? '&search=' + locals.search : '' %>"><i class="fa-solid fa-chevron-right"></i></a>
                <% } %>
            </div>
            <% } %>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script>
$(document).ready(function() {
    const $nameInput  = $('#brand_name');
    const $nameError  = $('#brand_name_error');

    function showError(msg) {
        $nameError.text(msg).show();
        $nameInput.css('border-color', '#e07070');
    }

    function clearError() {
        $nameError.text('').hide();
        $nameInput.css('border-color', '');
    }

    // Clear error as user types
    $nameInput.on('input', function() { clearError(); });

    $('#addBrandForm').on('submit', function(e) {
        e.preventDefault();
        clearError();

        const name = $nameInput.val().trim();
        const validationError = validateBrandName(name);
        if (validationError) {
            showError(validationError);
            return;
        }

        $.ajax({
            url: '/admin/addBrand',
            type: 'POST',
            data: { name: name },
            success: function(response) {
                window.location.href = '/admin/brand';
            },
            error: function(xhr) {
                const msg = (xhr.responseJSON && xhr.responseJSON.message)
                    ? xhr.responseJSON.message
                    : 'Error while adding brand';
                showError(msg);
            }
        });
    });
});

function validateBrandName(name) {
    if (!name || name.trim() === '') return 'Brand name is required.';
    if (/^[0-9]/.test(name)) return 'Brand name cannot start with a number.';
    if (name.trim().length < 2) return 'Brand name must be at least 2 characters.';
    return null;
}

async function editBrand(brandId, currentName) {
    const { value: newName } = await Swal.fire({
        title: 'Edit Brand',
        input: 'text',
        inputLabel: 'Brand Name',
        inputValue: currentName,
        showCancelButton: true,
        confirmButtonText: 'Save',
        cancelButtonText: 'Cancel',
        confirmButtonColor: '#b39343',
        inputValidator: (value) => {
            const err = validateBrandName(value ? value.trim() : '');
            if (err) return err;
            if (value.trim().toLowerCase() === currentName.trim().toLowerCase()) {
                return 'New name must be different from the current name';
            }
        }
    });

    if (newName) {
        $.ajax({
            url: '/admin/editBrand/' + brandId,
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ name: newName.trim() }),
            success: function(response) {
                if (response.status === true) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Updated!',
                        text: 'Brand name has been updated successfully.',
                        confirmButtonColor: '#b39343',
                        timer: 1800,
                        showConfirmButton: false
                    }).then(() => location.reload());
                } else {
                    Swal.fire('Failed', response.message || 'Failed to update brand', 'error');
                }
            },
            error: function(xhr) {
                const msg = xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : 'An error occurred while updating the brand';
                Swal.fire('Error', msg, 'error');
            }
        });
    }
}
</script>

<%- include("../../views/partials/admin/footer") %>