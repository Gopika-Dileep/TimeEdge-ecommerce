<%- include("../../views/partials/admin/header") %>

<head>
    <style>
        .badge-success-te {
            padding: 4px 10px; font-size: 9px; letter-spacing: 0.5px; font-weight: 600; text-transform: uppercase; border-radius: 2px;
            background: rgba(109,191,127,0.08); color: #6dbf7f; border: 1px solid rgba(109,191,127,0.15);
        }
        .badge-danger-te {
            padding: 4px 10px; font-size: 9px; letter-spacing: 0.5px; font-weight: 600; text-transform: uppercase; border-radius: 2px;
            background: rgba(224,112,112,0.08); color: #e07070; border: 1px solid rgba(224,112,112,0.15);
        }
        .brand-logo-circle {
            width: 44px; height: 44px; border-radius: 50%; overflow: hidden;
            display: inline-flex; align-items: center; justify-content: center;
            border: 1px solid var(--border); background: #ffffff;
        }
        .btn-table-action {
            background: none !important;
            border: 1px solid var(--border) !important;
            padding: 8px 16px !important;
            font-size: 11px !important;
            text-transform: uppercase !important;
            letter-spacing: 1px !important;
            font-weight: 600 !important;
            border-radius: 0 !important;
            transition: var(--transition);
        }
        .btn-table-action.block { color: #e07070 !important; }
        .btn-table-action.block:hover { background: rgba(224,112,112,0.05) !important; border-color: #e07070 !important; }
        .btn-table-action.unblock { color: #6dbf7f !important; }
        .btn-table-action.unblock:hover { background: rgba(109,191,127,0.05) !important; border-color: #6dbf7f !important; }

        /* Pagination */
        .pagination-container { display: flex; justify-content: center; gap: 8px; margin-top: 32px; }
        .pagination-container a, .pagination-container .current-page {
            display: inline-flex; align-items: center; justify-content: center;
            width: 40px; height: 40px; border: 1px solid var(--border);
            text-decoration: none; font-size: 13px; color: var(--text-secondary); transition: var(--transition);
        }
        .pagination-container a:hover, .pagination-container .current-page {
            border-color: var(--gold); color: var(--gold); background: var(--gold-glow);
        }
    </style>
</head>

<div class="content-container">
    <div class="content-header mb-5 animate-up">
        <span style="font-size:10px; letter-spacing:2px; text-transform:uppercase; color:var(--text-muted);">Catalog Settings</span>
        <h2 style="font-family:'Playfair Display',serif; font-size:1.8rem; font-weight:500; margin-top:4px;">Brands Management</h2>
    </div>

    <!-- Search Form -->
    <div class="search-container mb-4 animate-up delay-1">
        <form action="/admin/brand" method="GET" class="w-100 d-flex gap-2">
            <input type="text" class="form-control" placeholder="Search brands by name..." name="search" value="<%= locals.search || '' %>" />
            <button class="btn-primary" type="submit">Search</button>
            <% if (locals.search) { %>
                <a href="/admin/brand" class="btn btn-secondary" style="padding: 12px 20px; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; line-height: 1;">Clear</a>
            <% } %>
        </form>
    </div>

    <div class="row g-4 animate-up delay-1">
        <!-- Add Brand Side Panel -->
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h4>Add New Brand</h4>
                </div>
                <div class="card-body">
                    <form id="addBrandForm" method="POST" action="/admin/addBrand">
                        <div class="mb-4">
                            <label for="brand_name" class="form-label">Brand Name</label>
                            <input type="text" name="name" id="brand_name" placeholder="e.g. Audemars Piguet" class="form-control" required />
                        </div>
                        <button class="btn-primary w-100" type="submit">Create Brand</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Brands Grid Table -->
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h4>All Brands</h4>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table mb-0" style="vertical-align: middle;">
                            <thead>
                                <tr>
                                    <th>Brand Name</th>
                                    <th>Status</th>
                                    <th style="width: 140px; text-align: right; padding-right: 24px !important;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (locals.brand && brand.length > 0) { %>
                                    <% brand.forEach((brandItem) => { %>
                                        <tr>
                                            <td style="font-weight: 600; color: var(--text-primary);"><%= brandItem.name %></td>
                                            <td>
                                                <% if (!brandItem.isListed) { %>
                                                    <span class="badge-danger-te">Blocked</span>
                                                <% } else { %>
                                                    <span class="badge-success-te">Active</span>
                                                <% } %>
                                            </td>
                                            <td style="text-align: right; padding-right: 24px !important;">
                                                <% if (brandItem.isListed) { %>
                                                    <form method="POST" action="/admin/blockBrand/<%= brandItem._id %>" style="display: inline;">
                                                        <button class="btn-table-action block" type="submit">Block</button>
                                                    </form>
                                                <% } else { %>
                                                    <form method="POST" action="/admin/unblockBrand/<%= brandItem._id %>" style="display: inline;">
                                                        <button class="btn-table-action unblock" type="submit">Unblock</button>
                                                    </form>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="4" class="text-center py-5 text-muted">No Brands Found</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Pagination block -->
            <% if (locals.totalpage && totalpage > 1) { %>
            <div class="pagination-container animate-up">
                <% if (currentpage > 1) { %>
                    <a href="?page=<%= currentpage - 1 %><%= locals.search ? '&search=' + locals.search : '' %>"><i class="fa-solid fa-chevron-left"></i></a>
                <% } %>
                <% for (let i = 1; i <= totalpage; i++) { %>
                    <% if (i === currentpage) { %>
                        <span class="current-page"><%= i %></span>
                    <% } else { %>
                        <a href="?page=<%= i %><%= locals.search ? '&search=' + locals.search : '' %>"><%= i %></a>
                    <% } %>
                <% } %>
                <% if (currentpage < totalpage) { %>
                    <a href="?page=<%= currentpage + 1 %><%= locals.search ? '&search=' + locals.search : '' %>"><i class="fa-solid fa-chevron-right"></i></a>
                <% } %>
            </div>
            <% } %>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script>
$(document).ready(function() {
    $('#addBrandForm').on('submit', function(e) {
        e.preventDefault();
        
        const name = $('#brand_name').val().trim();
        if (!name) {
            Swal.fire({
                icon: 'warning',
                title: 'Required Field',
                text: 'Brand name is required.',
                confirmButtonColor: '#b39343'
            });
            return;
        }

        $.ajax({
            url: '/admin/addBrand',
            type: 'POST',
            data: { name: name },
            success: function(response) {
                window.location.href = '/admin/brand';
            },
            error: function(xhr) {
                let errorMsg = 'Error while adding brand';
                if (xhr.responseJSON && xhr.responseJSON.message) {
                    errorMsg = xhr.responseJSON.message;
                }
                Swal.fire({
                    icon: 'error',
                    title: 'Oops...',
                    text: errorMsg,
                    confirmButtonColor: '#b39343'
                });
            }
        });
    });
});
</script>

<%- include("../../views/partials/admin/footer") %>