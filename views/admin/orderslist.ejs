<%- include("../../views/partials/admin/header") %>

<head>
    <link rel="stylesheet" href="/css/admin-orders.css">
</head>

<div class="content-container">
    <div class="content-header mb-5 animate-up">
        <span style="font-size:10px; letter-spacing:2px; text-transform:uppercase; color:var(--text-muted);">Sales Operations</span>
        <h2 style="font-family:'Playfair Display',serif; font-size:1.8rem; font-weight:500; margin-top:4px;">Orders Management</h2>
    </div>

    <!-- Controls Bar -->
    <div class="controls-row mb-4 animate-up delay-1" style="display:flex; justify-content:space-between; align-items:center; gap:20px; flex-wrap:wrap;">
        <form action="/admin/orders" method="GET" style="display:flex; gap:10px; max-width:480px; flex:1;">
            <input type="text" class="form-control" placeholder="Search Order ID or customer..." name="search" value="<%= locals.search || '' %>" />
            <button class="btn-primary" type="submit">Search</button>
            <% if (locals.search) { %>
                <a href="/admin/orders" class="btn btn-secondary" style="padding: 12px 20px; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; line-height: 1;">Clear</a>
            <% } %>
        </form>
        <div style="display:flex; align-items:center; gap:10px;">
            <span style="font-size:12px; font-weight:500; color:var(--text-secondary);">Status Filter:</span>
            <form action="/admin/orders" method="GET" style="margin:0;">
                <% if (locals.search) { %>
                    <input type="hidden" name="search" value="<%= locals.search %>">
                <% } %>
                <select name="status" class="form-select" onchange="this.form.submit()" style="min-width:150px; height: 38px; font-size: 13px;">
                    <option value="">All Statuses</option>
                    <% ['pending', 'Processing', 'Shipped', 'delivered', 'Cancelled', 'Return request', 'Returned'].forEach(s => { %>
                        <option value="<%= s %>" <%= (locals.status === s) ? 'selected' : '' %>><%= s %></option>
                    <% }) %>
                </select>
            </form>
        </div>
    </div>

    <!-- Orders Card Table -->
    <div class="card animate-up delay-1">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table mb-0" style="vertical-align: middle;">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Customer Name</th>
                            <th>Date</th>
                            <th>Payment</th>
                            <th>Total Amount</th>
                            <th>Delivery Status</th>
                            <th style="width: 120px; text-align: right; padding-right: 24px !important;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (locals.orders && orders.length > 0) { %>
                            <% orders.forEach(order => { %>
                                <tr>
                                    <td class="order-ref">#<%= order._id.toString().slice(-8).toUpperCase() %></td>
                                    <td style="font-weight: 600; color: var(--text-primary);">
                                        <%= (order.user && order.user.name) ? order.user.name : 'Guest User' %>
                                    </td>
                                    <td><%= new Date(order.createdOn).toLocaleDateString('en-IN', {year:'numeric',month:'short',day:'numeric'}) %></td>
                                    <td style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 500;">
                                        <%= order.paymentMethod || 'COD' %>
                                    </td>
                                    <td style="font-weight: 600; color: var(--text-primary);">
                                        ₹<%= order.finalAmount.toLocaleString('en-IN') %>
                                    </td>
                                    <td>
                                        <% 
                                            let badgeClass = "badge-status";
                                            if (order.status === 'delivered') {
                                                badgeClass += " delivered";
                                            } else if (order.status === 'Cancelled' || order.status === 'Returned') {
                                                badgeClass += " " + order.status.toLowerCase();
                                            } else {
                                                badgeClass += " other";
                                            }
                                        %>
                                        <span id="badge-<%= order._id %>" class="<%= badgeClass %>">
                                            <%= order.status %>
                                        </span>
                                    </td>
                                    <td style="text-align: right; padding-right: 24px !important;">
                                        <a href="/admin/orders/<%= order._id %>" class="btn-primary" style="padding: 6px 12px; font-size: 10px; text-decoration: none; display: inline-block;">
                                            <i class="fa-regular fa-eye"></i> Details
                                        </a>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">No Orders Found</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    <% if (locals.totalpage && totalpage > 1) { %>
    <div class="pagination-container animate-up">
        <% if (currentpage > 1) { %>
            <a href="?page=<%= currentpage - 1 %><%= locals.search ? '&search=' + locals.search : '' %><%= locals.status ? '&status=' + locals.status : '' %>"><i class="fa-solid fa-chevron-left"></i></a>
        <% } %>
        <% for (let i = 1; i <= totalpage; i++) { %>
            <% if (i === currentpage) { %>
                <span class="current-page"><%= i %></span>
            <% } else { %>
                <a href="?page=<%= i %><%= locals.search ? '&search=' + locals.search : '' %><%= locals.status ? '&status=' + locals.status : '' %>"><%= i %></a>
            <% } %>
        <% } %>
        <% if (currentpage < totalpage) { %>
            <a href="?page=<%= currentpage + 1 %><%= locals.search ? '&search=' + locals.search : '' %><%= locals.status ? '&status=' + locals.status : '' %>"><i class="fa-solid fa-chevron-right"></i></a>
        <% } %>
    </div>
    <% } %>
</div>

<script>
async function updateStatus(orderId, status) {
    try {
        const response = await fetch('/admin/orders/change-status', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ orderId, status })
        });
        const result = await response.json();
        if (result.success) {
            const badge = document.getElementById('badge-' + orderId);
            badge.innerText = status;
            if (status === 'delivered') {
                badge.style.cssText = 'padding:4px 10px; font-size:9px; letter-spacing:0.5px; font-weight:600; text-transform:uppercase; border-radius:2px; background:rgba(109,191,127,0.08); color:#6dbf7f; border:1px solid rgba(109,191,127,0.15);';
            } else if (status === 'Cancelled' || status === 'Returned') {
                badge.style.cssText = 'padding:4px 10px; font-size:9px; letter-spacing:0.5px; font-weight:600; text-transform:uppercase; border-radius:2px; background:rgba(224,112,112,0.08); color:#e07070; border:1px solid rgba(224,112,112,0.15);';
            } else {
                badge.style.cssText = 'padding:4px 10px; font-size:9px; letter-spacing:0.5px; font-weight:600; text-transform:uppercase; border-radius:2px; background:rgba(240,180,48,0.08); color:#f0b430; border:1px solid rgba(240,180,48,0.15);';
            }
        } else {
            alert('Failed to update status: ' + result.message);
        }
    } catch (err) {
        console.error(err);
        alert('Network error while updating status');
    }
}
</script>

<%- include("../../views/partials/admin/footer") %>
