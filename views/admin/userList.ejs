<%- include("../../views/partials/admin/header") %>

<head>
    <style>
        .search-container {
            max-width: 500px;
            margin-bottom: 28px;
            display: flex;
            gap: 10px;
        }
        .btn-table-action {
            background: none !important;
            border: 1px solid var(--border) !important;
            padding: 8px 16px !important;
            font-size: 11px !important;
            text-transform: uppercase !important;
            letter-spacing: 1px !important;
            font-weight: 600 !important;
            border-radius: 0 !important;
            transition: var(--transition);
        }
        .btn-table-action.block { color: #e07070 !important; }
        .btn-table-action.block:hover { background: rgba(224,112,112,0.05) !important; border-color: #e07070 !important; }
        .btn-table-action.unblock { color: #6dbf7f !important; }
        .btn-table-action.unblock:hover { background: rgba(109,191,127,0.05) !important; border-color: #6dbf7f !important; }

        /* Pagination */
        .pagination-container { display: flex; justify-content: center; gap: 8px; margin-top: 32px; }
        .pagination-container a, .pagination-container .current-page {
            display: inline-flex; align-items: center; justify-content: center;
            width: 40px; height: 40px; border: 1px solid var(--border);
            text-decoration: none; font-size: 13px; color: var(--text-secondary); transition: var(--transition);
        }
        .pagination-container a:hover, .pagination-container .current-page {
            border-color: var(--gold); color: var(--gold); background: var(--gold-glow);
        }
    </style>
</head>

<div class="content-container">
    <div class="content-header mb-5 animate-up">
        <span style="font-size:10px; letter-spacing:2px; text-transform:uppercase; color:var(--text-muted);">User Management</span>
        <h2 style="font-family:'Playfair Display',serif; font-size:1.8rem; font-weight:500; margin-top:4px;">Customers List</h2>
    </div>

    <!-- Search Form -->
    <div class="search-container animate-up delay-1">
        <form action="/admin/users" method="GET" class="w-100 d-flex gap-2">
            <input type="text" class="form-control" placeholder="Search customer name or email..." name="search" value="<%= search %>" />
            <button class="btn-primary" type="submit">Search</button>
            <% if (search) { %>
                <a href="/admin/users" class="btn btn-secondary" style="padding: 12px 20px; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; line-height: 1;">Clear</a>
            <% } %>
        </form>
    </div>

    <div class="card animate-up delay-2">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table mb-0" style="vertical-align: middle;">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email Address</th>
                            <th>Phone Number</th>
                            <th style="width: 140px; text-align: right; padding-right: 24px !important;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (users && users.length > 0) { %>
                            <% users.forEach((customer) => { %>
                                <tr>
                                    <td style="font-weight: 600; color: var(--text-primary);"><%= customer.name || "N/A" %></td>
                                    <td><%= customer.email || "N/A" %></td>
                                    <td><%= customer.phone || "N/A" %></td>
                                    <td style="text-align: right; padding-right: 24px !important;">
                                        <% if (customer.isBlocked) { %>
                                            <button class="btn-table-action unblock unblock-btn" data-id="<%= customer._id %>">
                                                Unblock
                                            </button>
                                        <% } else { %>
                                            <button class="btn-table-action block block-btn" data-id="<%= customer._id %>">
                                                Block
                                            </button>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">No users found</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    <% if (pagination && pagination.totalpage > 1) { %>
    <div class="pagination-container animate-up">
        <% if (pagination.currentpage > 1) { %>
            <a href="?page=<%= pagination.currentpage - 1 %>&search=<%= search %>"><i class="fa-solid fa-chevron-left"></i></a>
        <% } %>
        <% for (let i = 1; i <= pagination.totalpage; i++) { %>
            <% if (i === pagination.currentpage) { %>
                <span class="current-page"><%= i %></span>
            <% } else { %>
                <a href="?page=<%= i %>&search=<%= search %>"><%= i %></a>
            <% } %>
        <% } %>
        <% if (pagination.currentpage < pagination.totalpage) { %>
            <a href="?page=<%= pagination.currentpage + 1 %>&search=<%= search %>"><i class="fa-solid fa-chevron-right"></i></a>
        <% } %>
    </div>
    <% } %>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        $(".block-btn").click(function () {
            const userId = $(this).data("id");
            $.ajax({
                url: `/admin/user-block/${userId}`,
                method: "GET",
                success: function (response) {
                    location.reload(); 
                }
            });
        });

        $(".unblock-btn").click(function () {
            const userId = $(this).data("id");
            $.ajax({
                url: `/admin/user-unblock/${userId}`,
                method: "GET",
                success: function (response) {
                    location.reload();
                }
            });
        });
    });
</script>

<%- include("../../views/partials/admin/footer") %>