<%- include("../../views/partials/admin/header") %>
<link rel="stylesheet" href="/css/admin-orders.css">

<div class="content-container">
    <div class="order-details-header animate-up">
        <a href="/admin/orders" class="back-link-btn">
            <i class="fa-solid fa-arrow-left"></i> Back to Orders
        </a>
        <div style="margin-top: 12px;">
            <span style="font-size:10px; letter-spacing:2px; text-transform:uppercase; color:var(--text-muted);">Order Management</span>
            <h2 style="font-family:'Playfair Display',serif; font-size:1.8rem; font-weight:500; margin-top:4px;">Order Details</h2>
        </div>
    </div>

    <!-- 3-Column Info Cards Grid -->
    <div class="cards-container animate-up delay-1">
        <div class="info-card">
            <h2 class="card-title">Order <span>Information</span></h2>
            <div class="info-item">
                <div class="info-label">Order ID</div>
                <div class="info-value order-ref">#<%= order.orderId %></div>
            </div>
            <div class="info-item">
                <div class="info-label">Date</div>
                <div class="info-value"><%= new Date(order.createdOn).toLocaleDateString('en-IN', {year:'numeric',month:'short',day:'numeric'}) %></div>
            </div>
            <div class="info-item">
                <div class="info-label">Payment</div>
                <div class="info-value"><%= order.paymentMethod %></div>
            </div>
            <div class="info-item">
                <div class="info-label">Status</div>
                <div class="info-value">
                    <span class="badge-status <%= order.status.toLowerCase().replace(/\s+/g, '_') %>">
                        <%= order.status %>
                    </span>
                </div>
            </div>
        </div>

        <div class="info-card">
            <h2 class="card-title">Customer <span>Details</span></h2>
            <div class="info-item">
                <div class="info-label">Name</div>
                <div class="info-value" style="font-weight: 600;"><%= order.user ? order.user.name : 'Guest User' %></div>
            </div>
            <div class="info-item">
                <div class="info-label">Phone</div>
                <div class="info-value"><%= order.user ? order.user.phone : 'N/A' %></div>
            </div>
            <div class="info-item">
                <div class="info-label">Shipping Address</div>
                <div class="info-value" style="text-align: right; line-height: 1.5;">
                    <% if (locals.specificAddress) { %>
                        <strong><%= specificAddress.name %></strong> (<%= specificAddress.addressType %>)<br>
                        <% if (specificAddress.landMark) { %><%= specificAddress.landMark %><br><% } %>
                        <%= specificAddress.city %>, <%= specificAddress.state %><br>
                        PIN: <%= specificAddress.pincode %>
                    <% } else { %>
                        <span style="color: #e07070;">Address unavailable</span>
                    <% } %>
                </div>
            </div>
        </div>

        <div class="info-card">
            <h2 class="card-title">Order <span>Summary</span></h2>
            <div class="info-item">
                <div class="info-label">Subtotal</div>
                <div class="info-value">₹<%= order.subtotal.toLocaleString('en-IN', {minimumFractionDigits: 2}) %></div>
            </div>
            <% if (order.productdiscount > 0) { %>
                <div class="info-item">
                    <div class="info-label">Product Discount</div>
                    <div class="info-value negative-value">-₹<%= order.productdiscount.toLocaleString('en-IN', {minimumFractionDigits: 2}) %></div>
                </div>
            <% } %>
            <% if (order.couponDiscount > 0) { %>
                <div class="info-item">
                    <div class="info-label">Coupon Discount</div>
                    <div class="info-value negative-value">-₹<%= order.couponDiscount.toLocaleString('en-IN', {minimumFractionDigits: 2}) %></div>
                </div>
            <% } %>
            <div class="info-item" style="border-top: 1px solid var(--border); padding-top: 12px; margin-top: 8px;">
                <div class="info-label" style="color: var(--text-primary);">Total Amount</div>
                <div class="info-value" style="font-family:'Playfair Display',serif; font-size: 1.2rem; font-weight: 600; color: var(--gold);">
                    ₹<%= order.finalAmount.toLocaleString('en-IN', {minimumFractionDigits: 2}) %>
                </div>
            </div>
        </div>
    </div>

    <!-- Ordered Items Table Card -->
    <div class="items-card animate-up delay-2">
        <div class="items-card-header">
            Ordered Items
        </div>
        <div class="table-responsive">
            <table class="items-table">
                <thead>
                    <tr>
                        <th>Product Item</th>
                        <th>Qty</th>
                        <th>Unit Price</th>
                        <th>Status</th>
                        <th style="text-align: right; padding-right: 28px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% order.orderedItems.forEach(item => { %>
                        <tr>
                            <td style="font-weight: 600; color: var(--text-primary);">
                                <%= item.products ? item.products.productName : 'Product' %>
                            </td>
                            <td><%= item.quantity %></td>
                            <td>₹<%= item.price.toLocaleString('en-IN', {minimumFractionDigits: 2}) %></td>
                            <td>
                                <span class="badge-status <%= item.status.toLowerCase().replace(/\s+/g, '_') %>">
                                    <%= item.status %>
                                </span>
                            </td>
                            <td style="text-align: right; padding-right: 28px;">
                                <% if (item.status === 'Return request') { %>
                                    <button class="edit-status-btn approve-btn" onclick="approveReturn('<%= item._id %>')">
                                        Approve Return
                                    </button>
                                    <button class="edit-status-btn decline-btn" onclick="declineReturn('<%= item._id %>')">
                                        Decline Return
                                    </button>
                                <% } else if (!['Cancelled', 'Returned', 'Return request'].includes(item.status)) { %>
                                    <button class="edit-status-btn" onclick="status('<%= item._id %>')">
                                        Edit Status
                                    </button>
                                <% } %>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>

        <% if (order.orderedItems.some((s) => s.cancelReason)) { %>
            <div class="cancelled-section">
                <div class="info-label" style="color: #e07070; margin-bottom: 6px;">Cancellation Reasons:</div>
                <% order.orderedItems.forEach(item => { %>
                    <% if (item.cancelReason) { %>
                        <div><strong><%= item.products ? item.products.productName : 'Item' %>:</strong> <%= item.cancelReason %></div>
                    <% } %>
                <% }); %>
            </div>
        <% } %>

        <% if (order.orderedItems.some((s) => s.returnReason)) { %>
            <div class="returned-section">
                <div class="info-label" style="color: #f0b430; margin-bottom: 6px;">Return Reasons:</div>
                <% order.orderedItems.forEach(item => { %>
                    <% if (item.returnReason) { %>
                        <div><strong><%= item.products ? item.products.productName : 'Item' %>:</strong> <%= item.returnReason %></div>
                    <% } %>
                <% }); %>
            </div>
        <% } %>

        <div class="items-total-footer">
            <span>Final Amount Paid:</span>
            <span class="total-val">₹<%= order.finalAmount.toLocaleString('en-IN', {minimumFractionDigits: 2}) %></span>
        </div>
    </div>
</div>

<!-- Edit Status Modal -->
<div id="status" class="modal">
    <div class="modal-content">
        <span class="close-modal" onclick="changeStatus()">&times;</span>
        <h3 style="font-family:'Playfair Display',serif; font-size: 1.3rem; margin-bottom: 20px;">Edit Item Status</h3>
        
        <div class="mb-4">
            <label class="form-label" style="font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--text-muted); display: block; margin-bottom: 8px;">Select New Status</label>
            <select id="statusSelect" style="display: none;">
                <option value="pending">Pending</option>
                <option value="Processing">Processing</option>
                <option value="Shipped">Shipped</option>
                <option value="delivered">Delivered</option>
                <option value="Cancelled">Cancelled</option>
                <option value="Returned">Returned</option>
            </select>

            <div class="custom-select-wrapper" id="customSelectWrapper">
                <div class="custom-select-trigger" onclick="toggleCustomDropdown(event)">
                    <span id="customStatusText">Pending</span>
                    <i class="fa-solid fa-chevron-down" style="font-size: 10px; color: var(--gold);"></i>
                </div>
                <div class="custom-options-menu" id="customOptionsMenu">
                    <div class="custom-option active" data-val="pending" onclick="selectCustomOption('pending', 'Pending')">Pending</div>
                    <div class="custom-option" data-val="Processing" onclick="selectCustomOption('Processing', 'Processing')">Processing</div>
                    <div class="custom-option" data-val="Shipped" onclick="selectCustomOption('Shipped', 'Shipped')">Shipped</div>
                    <div class="custom-option" data-val="delivered" onclick="selectCustomOption('delivered', 'Delivered')">Delivered</div>
                    <div class="custom-option" data-val="Cancelled" onclick="selectCustomOption('Cancelled', 'Cancelled')">Cancelled</div>
                    <div class="custom-option" data-val="Returned" onclick="selectCustomOption('Returned', 'Returned')">Returned</div>
                </div>
            </div>
        </div>

        <div id="cancelReasonContainer" class="mb-4" style="display: none;">
            <label for="cancelReason" class="form-label" style="font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--text-muted); display: block; margin-bottom: 8px;">Cancellation Reason</label>
            <textarea id="cancelReason" class="form-control" rows="3" placeholder="Provide reason for cancellation"></textarea>
        </div>

        <button class="btn-primary w-100" onclick="updateStatus()" style="height: 44px;">Save Changes</button>
    </div>
</div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        let currentItemId = '';

        function toggleCustomDropdown(e) {
            if (e) e.stopPropagation();
            const wrapper = document.getElementById('customSelectWrapper');
            wrapper.classList.toggle('open');
        }

        function selectCustomOption(val, text) {
            const selectEl = document.getElementById('statusSelect');
            selectEl.value = val;
            document.getElementById('customStatusText').innerText = text;

            document.querySelectorAll('.custom-option').forEach(opt => {
                opt.classList.toggle('active', opt.getAttribute('data-val') === val);
            });

            const cancelReasonContainer = document.getElementById('cancelReasonContainer');
            if (val === 'Cancelled') {
                cancelReasonContainer.style.display = 'block';
            } else {
                cancelReasonContainer.style.display = 'none';
            }

            const wrapper = document.getElementById('customSelectWrapper');
            wrapper.classList.remove('open');
        }

        function status(itemId) {
            currentItemId = itemId;
            document.getElementById('status').style.display = 'flex';

            const cancelReasonContainer = document.getElementById('cancelReasonContainer');
            cancelReasonContainer.style.display = 'none';
            document.getElementById('cancelReason').value = '';

            selectCustomOption('pending', 'Pending');
        }

        function changeStatus() {
            document.getElementById('status').style.display = 'none';
            const wrapper = document.getElementById('customSelectWrapper');
            if (wrapper) wrapper.classList.remove('open');
        }

        document.addEventListener('click', function(e) {
            const wrapper = document.getElementById('customSelectWrapper');
            if (wrapper && !wrapper.contains(e.target)) {
                wrapper.classList.remove('open');
            }
        });

        function updateStatus() {
            const newStatus = document.getElementById('statusSelect').value;
            let cancelReason = '';

            if (newStatus === 'Cancelled') {
                cancelReason = document.getElementById('cancelReason').value;
                if (!cancelReason.trim()) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Please provide a reason for cancellation',
                    });
                    return;
                }
            }

            fetch(`/admin/orders/update-status/${currentItemId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    status: newStatus,
                    cancelReason: cancelReason
                })
            })
                .then(response => {
                    if (!response.ok) {
                        return response.json().then(err => Promise.reject(err));
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Status Updated',
                            text: 'The order status has been successfully updated.',
                            showConfirmButton: false,
                            timer: 1500
                        }).then(() => {
                            changeStatus();
                            location.reload();
                        });
                    } else {
                        throw new Error(data.error || 'Error updating status');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: error.error || error.message || 'Something went wrong. Please try again.',
                    });
                });
        }

        window.onclick = function (event) {
            if (event.target == document.getElementById('status')) {
                changeStatus();
            }
        };

        function approveReturn(itemId) {
            Swal.fire({
                title: 'Confirm Return Approval',
                text: 'Are you sure you want to approve this return request?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, approve it'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch(`/admin/orders/approve-return/${itemId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json'
                        }
                    })
                        .then(response => {
                            if (!response.ok) {
                                return response.json().then(err => Promise.reject(err));
                            }
                            return response.json();
                        })
                        .then(data => {
                            if (data.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Success',
                                    text: data.message || 'Return request approved successfully',
                                    showConfirmButton: false,
                                    timer: 1500
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                throw new Error(data.error || 'Error processing return');
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: error.error || 'Something went wrong. Please try again.',
                            });
                        });
                }
            });
        }

        function declineReturn(itemId) {
            Swal.fire({
                title: 'Confirm Return Decline',
                text: 'Are you sure you want to decline this return request?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, decline it'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch(`/admin/orders/decline-return/${itemId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json'
                        }
                    })
                        .then(response => {
                            if (!response.ok) {
                                return response.json().then(err => Promise.reject(err));
                            }
                            return response.json();
                        })
                        .then(data => {
                            if (data.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Success',
                                    text: data.message || 'Return request declined successfully',
                                    showConfirmButton: false,
                                    timer: 1500
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                throw new Error(data.error || 'Error declining return');
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: error.error || 'Something went wrong. Please try again.',
                            });
                        });
                }
            });
        }
    </script>

    <%- include("../../views/partials/admin/footer") %>