<!DOCTYPE HTML>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>TimeEdge — Administration Portal</title>
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg-body: #fbfbf9;
            --bg-card: #ffffff;
            --text-primary: #1c1a17;
            --text-secondary: #5c554c;
            --text-muted: #948c82;
            --gold: #b39343;
            --gold-light: #d4b66a;
            --gold-glow: rgba(179, 147, 67, 0.05);
            --border: #edece8;
            --border-hover: #d1cfc9;
            --sidebar-width: 260px;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-body);
            color: var(--text-primary);
            min-height: 100vh;
        }

        /* Layout Structure */
        .app-container {
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar - Elegant and Slim Dark Theme contrast */
        .sidebar {
            width: var(--sidebar-width);
            background: #11100e;
            height: 100vh;
            position: fixed;
            left: 0; top: 0;
            overflow-y: auto;
            border-right: 1px solid #1c1a17;
            padding: 2rem 1.5rem;
            z-index: 1001;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: var(--transition);
        }

        .brand {
            font-family: 'Playfair Display', serif;
            font-size: 1.3rem;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #ffffff;
            text-decoration: none;
            display: block;
            margin-bottom: 2rem;
            text-align: center;
            border-bottom: 1px solid rgba(255,255,255,0.06);
            padding-bottom: 20px;
        }
        .brand span { color: var(--gold); }

        .nav-menu {
            list-style: none;
            padding: 0;
            margin: 0;
            flex-grow: 1;
        }

        .nav-item {
            margin-bottom: 6px;
        }

        .nav-link {
            display: flex;
            align-items: center;
            padding: 12px 16px;
            color: #a39c93;
            text-decoration: none;
            font-size: 13px;
            letter-spacing: 0.5px;
            transition: var(--transition);
            border-radius: 4px;
            border-left: 3px solid transparent;
        }

        .nav-link i {
            margin-right: 14px;
            width: 20px;
            text-align: center;
            font-size: 14px;
            color: #706960;
            transition: var(--transition);
        }

        .nav-link:hover, .nav-link.active {
            background: rgba(255, 255, 255, 0.03);
            color: #ffffff;
            font-weight: 500;
            border-left-color: var(--gold);
        }
        .nav-link:hover i, .nav-link.active i {
            color: var(--gold);
        }

        /* Top Header */
        .header {
            height: 64px;
            background: var(--bg-card);
            border-bottom: 1px solid var(--border);
            position: fixed;
            top: 0; left: var(--sidebar-width); right: 0;
            z-index: 1000;
            display: flex;
            align-items: center;
            padding: 0 2rem;
            justify-content: space-between;
            transition: var(--transition);
        }

        .toggle-btn {
            display: none;
            background: none;
            border: none;
            font-size: 1.25rem;
            cursor: pointer;
            color: var(--text-primary);
        }

        .logout-link {
            font-size: 12px;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--text-secondary);
            text-decoration: none;
            transition: color 0.3s;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .logout-link:hover { color: var(--gold); }

        /* Workspace Main Content Wrapper */
        .content-area {
            flex: 1;
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            padding-top: 64px;
            background-color: var(--bg-body);
            transition: var(--transition);
        }

        .content-main {
            padding: 2.5rem;
            width: 100%;
        }

        /* General Card & Forms Overrides */
        .card {
            background: var(--bg-card) !important;
            border: 1px solid var(--border) !important;
            border-radius: 0 !important;
            box-shadow: none !important;
        }
        .card-header {
            background: transparent !important;
            border-bottom: 1px solid var(--border) !important;
            padding: 1.5rem !important;
        }
        .card-header h4, .card-header h2 {
            font-family: 'Playfair Display', serif;
            font-size: 1.2rem;
            color: var(--text-primary);
            margin: 0;
            font-weight: 500;
        }
        .card-body { padding: 1.5rem !important; }

        /* Table Aesthetics */
        .table {
            --bs-table-bg: transparent !important;
            border-color: var(--border) !important;
        }
        .table th {
            font-size: 11px !important;
            text-transform: uppercase !important;
            letter-spacing: 1.5px !important;
            color: var(--text-muted) !important;
            font-weight: 600 !important;
            border-bottom: 1px solid var(--border) !important;
            padding: 12px 10px !important;
        }
        .table td {
            font-size: 13px !important;
            color: var(--text-secondary) !important;
            vertical-align: middle !important;
            padding: 14px 10px !important;
            border-bottom: 1px solid var(--border) !important;
        }

        /* Buttons styling */
        .btn-primary, .btn-submit, .btn-gold-fill {
            background: var(--gold) !important;
            border-color: var(--gold) !important;
            color: #ffffff !important;
            font-family: 'Inter', sans-serif;
            font-size: 11px !important;
            font-weight: 600 !important;
            letter-spacing: 1.5px !important;
            text-transform: uppercase !important;
            border-radius: 0 !important;
            padding: 12px 24px !important;
            transition: var(--transition) !important;
        }
        .btn-primary:hover, .btn-submit:hover, .btn-gold-fill:hover {
            background: var(--gold-light) !important;
            border-color: var(--gold-light) !important;
            box-shadow: 0 4px 15px rgba(179, 147, 67, 0.15) !important;
        }

        .btn-secondary, .btn-table-action {
            background: none !important;
            border: 1px solid var(--border) !important;
            color: var(--text-secondary) !important;
            font-family: 'Inter', sans-serif;
            font-size: 11px !important;
            font-weight: 600 !important;
            letter-spacing: 1.5px !important;
            text-transform: uppercase !important;
            border-radius: 0 !important;
            padding: 12px 24px !important;
            transition: var(--transition) !important;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }
        .btn-secondary:hover, .btn-table-action:hover {
            border-color: var(--border-hover) !important;
            color: var(--text-primary) !important;
            background: rgba(0,0,0,0.02) !important;
        }

        /* Form Inputs */
        .form-control, .form-select {
            background: rgba(0,0,0,0.01) !important;
            border: 1px solid var(--border) !important;
            border-radius: 0 !important;
            color: var(--text-primary) !important;
            font-size: 13px !important;
            padding: 10px 14px !important;
            outline: none !important;
        }
        .form-control:focus, .form-select:focus {
            border-color: var(--gold) !important;
            background: var(--gold-glow) !important;
            box-shadow: none !important;
        }

        /* Responsive Design */
        @media (max-width: 1024px) {
            .sidebar {
                transform: translateX(-100%);
            }
            .sidebar.active {
                transform: translateX(0);
            }
            .header {
                left: 0;
            }
            .content-area {
                margin-left: 0;
            }
            .toggle-btn {
                display: block;
            }
        }
    </style>
</head>
<body>
    <div class="app-container">
        <!-- Top Header -->
        <header class="header">
            <button class="toggle-btn" id="sidebarToggle">
                <i class="fas fa-bars"></i>
            </button>
            <div style="font-family:'Playfair Display',serif; font-size:14px; font-weight:600; color:var(--text-muted);">
                TimeEdge Portal
            </div>
            <div class="header-right">
                <a href="/admin/logout" class="logout-link">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                    <span>Logout</span>
                </a>
            </div>
        </header>

        <!-- Sidebar Navigation -->
        <aside class="sidebar" id="sidebar">
            <div>
                <a href="/admin" class="brand">TIME<span>EDGE</span></a>
                <ul class="nav-menu">
                    <li class="nav-item">
                        <a href="/admin" class="nav-link">
                            <i class="fas fa-th-large"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/admin/salesreport" class="nav-link">
                            <i class="fas fa-chart-line"></i>
                            <span>Sales Report</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/admin/Product" class="nav-link">
                            <i class="fas fa-box"></i>
                            <span>Products</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/admin/orders" class="nav-link">
                            <i class="fas fa-shopping-cart"></i>
                            <span>Orders</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/admin/users" class="nav-link">
                            <i class="fas fa-users"></i>
                            <span>Customers</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/admin/coupon" class="nav-link">
                            <i class="fas fa-star"></i>
                            <span>Coupons</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/admin/category" class="nav-link">
                            <i class="fas fa-list"></i>
                            <span>Categories</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/admin/brand" class="nav-link">
                            <i class="fas fa-cogs"></i>
                            <span>Brands</span>
                        </a>
                    </li>
                </ul>
            </div>
        </aside>

        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const currentPath = window.location.pathname;
                const navLinks = document.querySelectorAll(".sidebar .nav-link");
                navLinks.forEach(link => {
                    link.classList.remove("active");
                    const linkPath = new URL(link.href, window.location.origin).pathname;
                    // Strict match for dashboard, prefix matches for other subpaths
                    if (linkPath === "/admin" && (currentPath === "/admin" || currentPath === "/admin/dashboard")) {
                        link.classList.add("active");
                    } else if (linkPath !== "/admin" && currentPath.startsWith(linkPath)) {
                        link.classList.add("active");
                    }
                });

                // Toggle menu drawer responsiveness
                const toggleBtn = document.getElementById("sidebarToggle");
                if (toggleBtn) {
                    toggleBtn.addEventListener("click", function () {
                        document.getElementById("sidebar").classList.toggle("active");
                    });
                }
            });
        </script>

        <!-- Main Workspace Area -->
        <script src="/js/form-validation.js"></script>
        <main class="content-area">
            <div class="content-main">
                <!-- views template injection wrapper -->
