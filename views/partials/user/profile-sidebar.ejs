<% const currentPath = typeof path !== 'undefined' ? path : (typeof locals.path !== 'undefined' ? locals.path : '') %>
<aside class="profile-sidebar animate-up delay-1">
    <div class="profile-nav-card">
        <ul class="profile-nav-list">
            <li>
                <a href="/accountdetails" class="profile-nav-item <%= currentPath === '/accountdetails' ? 'active' : '' %>">
                    <i class="fa-regular fa-user"></i> Account Details
                </a>
            </li>
            <li>
                <a href="/address" class="profile-nav-item <%= currentPath === '/address' ? 'active' : '' %>">
                    <i class="fa-regular fa-address-card"></i> Saved Addresses
                </a>
            </li>
            <li>
                <a href="/orders" class="profile-nav-item <%= currentPath === '/orders' ? 'active' : '' %>">
                    <i class="fa-solid fa-bag-shopping"></i> My Orders
                </a>
            </li>
            <li>
                <a href="/wishlist" class="profile-nav-item <%= currentPath === '/wishlist' ? 'active' : '' %>">
                    <i class="fa-regular fa-heart"></i> My Wishlist
                </a>
            </li>
            <li>
                <a href="/wallet" class="profile-nav-item <%= currentPath === '/wallet' ? 'active' : '' %>">
                    <i class="fa-solid fa-wallet"></i> My Wallet
                </a>
            </li>
            <li>
                <a href="/refer" class="profile-nav-item <%= currentPath === '/refer' ? 'active' : '' %>">
                    <i class="fa-solid fa-gift"></i> Refer & Earn
                </a>
            </li>
            <li>
                <a href="/password" class="profile-nav-item <%= currentPath === '/password' ? 'active' : '' %>">
                    <i class="fa-solid fa-key"></i> Security Settings
                </a>
            </li>
            <li>
                <a href="/change-email" class="profile-nav-item <%= currentPath === '/change-email' ? 'active' : '' %>">
                    <i class="fa-regular fa-envelope"></i> Update Email
                </a>
            </li>
            <li style="margin-top: 20px; border-top: 1px solid var(--border); padding-top: 20px;">
                <a href="/logout" class="profile-nav-item" style="color: #e07070;">
                    <i class="fa-solid fa-arrow-right-from-bracket" style="color: #e07070;"></i> Logout
                </a>
            </li>
        </ul>
    </div>
</aside>